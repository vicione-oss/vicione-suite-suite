@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Localization.Resources

<Dialog HeaderText="@Localization.UnsavedChangesPopup.Title"
        Height="35%"
        Width="35%"
        Visible="@_visible"
        OnClosing="@DialogClosing">

    <Body>
        <DialogBodyTextLayout>
            @Localization.UnsavedChangesPopup.Message
        </DialogBodyTextLayout>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@SaveButtonClick" Text="@CommonVocabulary.Save" />
        <DialogFooterButton OnClick="@RevertButtonClick" Text="@CommonVocabulary.RevertVerb" />
        <DialogFooterButton OnClick="@CancelButtonClick" Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>
