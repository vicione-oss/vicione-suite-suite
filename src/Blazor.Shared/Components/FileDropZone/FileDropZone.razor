@{
    var cssClasses = new List<string> { "file-drop-zone" };

    if (!string.IsNullOrWhiteSpace(CssClass))
        cssClasses.AddRange(CssClass.Split(" "));
}

<div class="@string.Join(" ", cssClasses)" @ref="_elementReference">
    <CascadingValue TValue="IFileDropZone" Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>
