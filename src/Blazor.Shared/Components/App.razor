@using Blazor.Shared.Components.ReconnectModal
@using Microsoft.Extensions.Hosting

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="_content/ViciOne.Ui.Shared.Dx/css/dx-bootstrap-custom.css" rel="stylesheet" />
    <link href="_content/ViciOne.Suite.Blazor.Shared/css/jquery-ui.min.css" rel="stylesheet" />
    <link href="_content/ViciOne.Suite.Blazor.Shared/css/suite.css" rel="stylesheet" />
    <link href="@RenderModeProvider.AppStyleSheet" rel="stylesheet" />
    <link rel="icon" type="image/icon" href="_content/ViciOne.Suite.Blazor.Shared/favicon.ico" />
    <HeadOutlet @rendermode="RenderModeProvider.HeaderRenderMode" />
</head>
<body>
    <Routes @rendermode="ConfiguredRenderMode" />
    <div id="blazor-error-ui">
        @if (Env.IsDevelopment())
        {
            <text>
                An unhandled exception has occurred. See browser dev tools for details.
            </text>
        }
        else
        {
            <text>
                An error has occurred. This app may no longer respond until reloaded.
            </text>
        }
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <ReconnectModal />

    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="_content/ViciOne.Suite.Blazor.Shared/js/reconnect.js"></script>
    <script async src="_content/ViciOne.Suite.Blazor.Shared/js/loadjs.min.js"></script>
    <script async src="_content/ViciOne.Suite.Blazor.Shared/js/suite.js"></script>
</body>
</html>
