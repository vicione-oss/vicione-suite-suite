@using Blazor.Shared.MessageBanner.Components
@using Blazor.Shared.Settings.Components
@using Blazor.Shared.UserManagement.Components
@using ViciOne.Ui.Blazor.Components.LoadingSpinner.Components
@using ViciOne.Ui.Blazor.Components.Popup.Components
@using ViciOne.Ui.Blazor.Components.Tooltip.Components

@inherits LayoutComponentBase

<main class="layout-main-content @(_isTemplateLogin ? "template-login" : string.Empty)">
    <PageTitle>@LayoutService.InstanceName</PageTitle>
    
    @if (!_isTemplateLogin)
    {
        <div>
            <TopBar />
        </div>
    }

    <div class="layout-main-body">
        <LoadingSpinner Visible="@LayoutService.IsLoadingOverlayVisible" />
        @Body
        <MessageBannerDialog />
        <MasterHealthObserver />
        <TooltipDisplay />
    </div>
    
    <PopupRoot />
    <AuthenticationCookieUpdater />
    <SettingsPopup />
</main>
