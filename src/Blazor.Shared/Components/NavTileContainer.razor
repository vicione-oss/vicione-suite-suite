@using Sdk.Client.Extensions
@using Sdk.Client.NavTiles.Components

@{
    var containerCssClasses = new List<string>
    {
        "nav-tile-container", $"horizontal-span-{NavTileState.HorizontalSpan.ToString().ToHyphenSeparated()}"
    };

    if (!NavTileState.Enabled)
        containerCssClasses.Add("disabled");

    if (NavTileState.IsLoading)
        containerCssClasses.Add("loading");
}

<div class="@string.Join(" ", containerCssClasses)">
    @{
        if (NavTileState.IsLoading)
        {
            <div class="nav-tile-container__loading-spinner">
                <div class="dot-flashing"></div>
            </div>
        }

        var linkAttributes = new Dictionary<string, object>();

        if (NavTileState.Enabled)
        {
            if (string.IsNullOrWhiteSpace(NavTileState.LinkTarget))
                linkAttributes.Add("href", "#");
            else
                linkAttributes.Add("href", NavTileState.LinkTarget);
        }
    }

    <a class="nav-tile-container__link" @attributes="@linkAttributes" @onclick="LinkClicked" @onclick:preventDefault="true">
        @{
            var navTileParameters = new Dictionary<string, object?>
            {
                { nameof(NavTileBase.State), NavTileState }
            };
        }
        <DynamicComponent Type="@NavTileComponentType" Parameters="@navTileParameters" @ref="_navTile" />
    </a>
</div>
