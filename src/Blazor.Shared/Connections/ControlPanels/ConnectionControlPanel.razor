@using Blazor.Shared.Connections.Services
@using Sdk.Client.Connections
@using ViciOne.Ui.Localization.Resources
@using Blazor.Shared.Connections.Components
@using Sdk.Client.Components.Settings.Expanders
@using ViciOne.Ui.Blazor.Components.CheckBox

@inherits ControlPanelBase<ConnectionControlPanelState>

<DescriptionBanner Title="@TechnicalTerms.Connection" IconCssClass="@_descriptionBannerIconCssClass">
    @Localization.ConnectionControlPanel.DescriptionBannerContent
</DescriptionBanner>

@if (State.EditConnectionModel is not null)
{
    <SettingsLayout>
        <SettingsGroup Title="@CommonVocabulary.Common" @bind-Expanded="@State.CommonSettingsGroupExpanded">
            <SettingsField Label="@CommonVocabulary.Name">
                <SettingsFieldTextBox Placeholder="@CommonVocabulary.Name" @bind-Value="@State.EditConnectionModel.Name"
                                      Enabled="@(!State.EditConnectionModel.Connection.Managed)"
                                      @bind-Value:after="BeginEdit" />
            </SettingsField>

            <SettingsField Label="@CommonVocabulary.Description">
                <SettingsFieldTextBox Placeholder="@CommonVocabulary.Description"
                                      @bind-Value="@State.EditConnectionModel.Description"
                                      Enabled="@(!State.EditConnectionModel.Connection.Managed)"
                                      @bind-Value:after="BeginEdit" />
            </SettingsField>

            <SettingsField Label="@TechnicalTerms.TagPlural">
                <div class="suite-tag-edit-box">
                    <DxTagBox AllowCustomTags="true"
                              Data="@State.AvailableTagTexts"
                              Values="@State.TagValues"
                              Tags="@State.EditModelTagTexts"
                              TagsExpression="@(() => State.EditModelTagTexts)"
                              TagsChanged="@TagsChanged"
                              HideSelectedItems="false"
                              Enabled="@(!State.EditConnectionModel.Connection.Managed)"
                              DropDownWidthMode="DropDownWidthMode.EditorWidth" />
                </div>
            </SettingsField>
            
            <SettingsField Label="@Localization.ConnectionControlPanel.Managed">
                <CheckBox @bind-Value="@State.EditConnectionModel.Connection.Managed" Enabled="false" />
            </SettingsField>
        </SettingsGroup>

        @if (State.EditConnectionModel.TypedConnection is not null)
        {
            <SettingsGroup Title="@(connectionTypeUiRegistry.TryGetDisplayName(State.EditConnectionModel.Type, out var displayName) ? displayName : string.Empty)" Expanded="true">
                <Expander>
                        <ComboBoxExpander Items="@_connectionTypes"
                                          ReadOnly="@State.ConnectionId.HasValue"
                                          ValueSelector="@(i => i.Value)"
                                          TextSelector="@(i => i.Text)"
                                          @bind-Value="@State.EditConnectionModel.Type" />
                </Expander>

                <ChildContent>
                    @{
                        _connectionSettingsComponentParameters[nameof(ConnectionSettingsComponentBase<MqttConnection>.Connection)] = State.EditConnectionModel.TypedConnection;

                        @if (connectionTypeUiRegistry.TryGetComponentType(State.EditConnectionModel.Type, out var componentType))
                        {
                            <DynamicComponent Type="@componentType" Parameters="@_connectionSettingsComponentParameters" />
                        }
                    }
                </ChildContent>
            </SettingsGroup>
        }

        <TestSettingsGroup Model="@State.EditConnectionModel" />
    </SettingsLayout>
}
