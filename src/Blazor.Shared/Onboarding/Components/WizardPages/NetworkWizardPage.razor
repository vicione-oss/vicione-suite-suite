@using Blazor.Shared.Onboarding.Extensions
@using Blazor.Shared.Onboarding.Services
@using Blazor.Shared.Settings.NetworkInterface.Components
@using Sdk.Client.Wizards.Components
@using ViciOne.Ui.Localization.Resources

@inherits WizardPage<NetworkWizardPageState>

<DescriptionBanner Title="@Localization.NetworkWizardPage.DescriptionBannerTitle" IconCssClass="@_descriptionBannerIconCssClass">
    @Localization.NetworkWizardPage.DescriptionBannerContent
</DescriptionBanner>

<SettingsLayout>
    <SettingsGroup Title="@Localization.NetworkWizardPage.RulesAndGuidelinesTitle" @bind-Expanded="State.RulesAndGuidelinesExpanded">
        <SettingsInformation>
            <div class="rules-and-guidelines">
                <ul>
                    <li>
                        <strong>@Localization.NetworkWizardPage.Rule1</strong>

                        <ul>
                            <li>@string.Format(Localization.NetworkWizardPage.Rule1a, State.LocalNetwork.GetFriendlyName())</li>
                            <li>@string.Format(Localization.NetworkWizardPage.Rule1b, State.InternetConnection.GetFriendlyName())</li>
                        </ul>
                    </li>
                </ul>

                <ul>
                    <li>
                        <strong>@Localization.NetworkWizardPage.Rule2</strong>

                        <ul>
                            <li>@Localization.NetworkWizardPage.Rule2a</li>
                            <li>@Localization.NetworkWizardPage.Rule2b</li>
                        </ul>
                    </li>
                </ul>

                <ul>
                    <li>
                        <strong>@Localization.NetworkWizardPage.Rule3</strong>

                        <ul>
                            <li>@Localization.NetworkWizardPage.Rule3a</li>
                            <li>@Localization.NetworkWizardPage.Rule3b</li>
                        </ul>
                    </li>
                </ul>

                <ul>
                    <li>
                        <strong>@Localization.NetworkWizardPage.Rule4</strong>

                        <ul>
                            <li>@Localization.NetworkWizardPage.Rule4a</li>
                            <li>@Localization.NetworkWizardPage.Rule4b</li>
                        </ul>
                    </li>
                </ul>

                <ul>
                    <li>
                        <strong>@Localization.NetworkWizardPage.TermsExplained</strong>

                        <ul>
                            <li>
                                @TechnicalTerms.IpAddress

                                <ul>
                                    <li>@Localization.NetworkWizardPage.IpAddressExplanation</li>
                                    <li>@(CommonVocabulary.Example): 192.168.1.100</li>
                                </ul>
                            </li>
                        </ul>

                        <ul>
                            <li>
                                @TechnicalTerms.SubnetMask

                                <ul>
                                    <li>@Localization.NetworkWizardPage.SubnetMaskExplanation</li>
                                    <li>@(CommonVocabulary.Example): 255.255.0.0</li>
                                </ul>
                            </li>
                        </ul>

                        <ul>
                            <li>
                                @TechnicalTerms.DefaultGateway

                                <ul>
                                    <li>@Localization.NetworkWizardPage.DefaultGatewayExplanation</li>
                                    <li>@(CommonVocabulary.Example): 192.168.1.1</li>
                                </ul>
                            </li>
                        </ul>

                        <ul>
                            <li>
                                @TechnicalTerms.DnsServer

                                <ul>
                                    <li>@Localization.NetworkWizardPage.DnsServerExplanation</li>
                                    <li>@(CommonVocabulary.Example): 8.8.8.8</li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                </ul>

                <strong>@Localization.NetworkWizardPage.IntermediateSentence</strong>
            </div>
        </SettingsInformation>
    </SettingsGroup>

    <IpV4SettingsGroup Title="@State.InternetConnection.GetFriendlyNameVerbose()"
                       @bind-ConfigurationMode="State.InternetConnection.ConfigurationMode"
                       @bind-IpAddress="State.InternetConnection.IpAddress"
                       @bind-SubnetMask="State.InternetConnection.SubnetMask"
                       @bind-DefaultGateway="State.InternetConnection.DefaultGateway"
                       Changed="BeginEdit" />

    <IpV4SettingsGroup Title="@State.LocalNetwork.GetFriendlyNameVerbose()"
                       @bind-ConfigurationMode="State.LocalNetwork.ConfigurationMode"
                       @bind-IpAddress="State.LocalNetwork.IpAddress"
                       @bind-SubnetMask="State.LocalNetwork.SubnetMask"
                       @bind-DefaultGateway="State.LocalNetwork.DefaultGateway"
                       Changed="BeginEdit" />

    <DnsServerSettingsGroup @bind-Expanded="State.Dns.Enabled"
                            Details="State.Dns.Details"
                            Changed="BeginEdit" />
</SettingsLayout>
