@using Blazor.Shared.Onboarding.Services
@using Sdk.Client.Wizards.Components
@using ViciOne.Ui.Localization.Resources

@inherits WizardPage<PasswordWizardPageState>

<DescriptionBanner Title="@Localization.PasswordWizardPage.DescriptionBannerTitle" IconCssClass="@_descriptionBannerIconCssClass">
    @Localization.PasswordWizardPage.DescriptionBannerContent
</DescriptionBanner>

<SettingsLayout>
    <SettingsGroup Title="@Localization.PasswordWizardPage.RulesAndGuidelinesTitle" @bind-Expanded="State.RulesAndGuidelinesExpanded">
        <SettingsInformation>
            <div class="rules-and-guidelines">
                <strong>@CommonVocabulary.RulePlural</strong>

                <ul>
                    <li>@string.Format(Localization.PasswordWizardPage.Rule1, State.PasswordMinimumLength)</li>
                    <li>
                        @Localization.PasswordWizardPage.Rule2
                
                        <ul>
                            <li>@Localization.PasswordWizardPage.Rule2a</li>
                            <li>@Localization.PasswordWizardPage.Rule2b</li>
                            <li>@Localization.PasswordWizardPage.Rule2c</li>
                            <li>@Localization.PasswordWizardPage.Rule2d</li>
                        </ul>
                    </li>
                </ul>

                <strong>@CommonVocabulary.GuidelinePlural</strong>

                <ul>
                    <li>@Localization.PasswordWizardPage.Guideline1</li>
                </ul>

                <p>
                    @Localization.PasswordWizardPage.IntermediateSentence
                </p>

                <strong>@Localization.PasswordWizardPage.SecurityNotice</strong>
            </div>
        </SettingsInformation>
    </SettingsGroup>

    <SettingsGroup Title="@Localization.PasswordWizardPage.EnterAdministratorDataTitle">
        <SettingsField Label="@TechnicalTerms.Username">
            <SettingsFieldTextBox Placeholder="@TechnicalTerms.Username" Value="@State.Username" Enabled="false" />
        </SettingsField>

        <SettingsField Label="@CommonVocabulary.Password">
            <SettingsFieldTextBox Placeholder="@CommonVocabulary.Password"
                                  Password="true"
                                  @bind-Value="@State.Password"
                                  @bind-Value:after="BeginEdit" />
        </SettingsField>

        <SettingsField Label="@Onboarding.Localization.SettingsFieldLabels.RepeatPassword">
            <SettingsFieldTextBox Placeholder="@Onboarding.Localization.SettingsFieldLabels.RepeatPassword"
                                  Password="true"
                                  @bind-Value="@State.RepeatPassword"
                                  @bind-Value:after="BeginEdit" />
        </SettingsField>
    </SettingsGroup>
</SettingsLayout>
