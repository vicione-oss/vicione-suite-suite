@using Blazor.Shared.Onboarding.Components.Pages
@using Sdk.Client.Components.Wallpaper
@using Sdk.Client.Components.Wallpaper.Enums
@using Sdk.Client.Wizards.Components

@attribute [Route(Constants.Route)]

