@using System.Globalization
@using Blazor.Shared.SystemInformation.Components.ProcessOverview
@using Blazor.Shared.SystemInformation.Models
@using ViciOne.Ui.Blazor.Components.CopyToClipboardButton.Components
@using ViciOne.Ui.Blazor.Components.CopyToClipboardButton.Enums
@using ViciOne.Ui.Blazor.Components.LoadingSpinner.Components
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@using Text = Blazor.Shared.SystemInformation.Components.Localization.ProcessComponent

<div class="process-overview">
    @if (!Sampler.IsAvailable)
    {
        <div class="notice">@Text.LinuxOnly</div>
    }
    else if (_snapshot is not { } snapshot)
    {
        <LoadingSpinner Visible="true" />
    }
    else
    {
        <div class="overview">
            <div class="full-row">
                <section class="panel node-header" aria-label="@InstanceName">
                    <div class="node-icon">
                        <MonochromeIcon Name="MonochromeIconName.ServerLight" Size="MonochromeIconSize.Large" />
                    </div>
                    <div class="node-info">
                        <div class="title-row">
                            <h1 title="@InstanceName">@InstanceName</h1>
                            <StatusChip OverThreshold="@SystemOverThreshold" ShowDot="true" />
                            <span class="chip status-info">@InstanceType</span>
                        </div>
                        <div class="description">@HardwareDescription</div>
                        <div class="facts">
                            <span><span class="muted">@Text.Uptime</span> <span class="mono">@UptimeText</span></span>
                            <span><span class="muted">@Text.Updated</span> <span class="mono">@UpdatedText</span></span>
                            <span class="muted">@Text.SampledWhileOpen</span>
                        </div>
                    </div>
                    <div class="actions">
                        <CopyToClipboardButton TextToCopy="GetSnapshotText"
                                               Title="@Text.SnapshotHint"
                                               Size="CopyToClipboardButtonSize.Medium" />
                    </div>
                </section>
            </div>

            <div class="full-row">
                <section class="summary-tiles" aria-label="@Text.KeyFigures">
                    @foreach (var tile in _tiles)
                    {
                        <div class="tile @(tile.Critical ? "critical" : tile.Over ? "over" : null)" @key="tile.Label" title="@tile.Tooltip">
                            <div class="head-row">
                                <div class="value @(tile.Critical ? "critical" : tile.Over ? "over" : null)">
                                    @tile.Value
                                    @if (tile.Unit is { } unit)
                                    {
                                        <span class="unit">@unit</span>
                                    }
                                    @if (tile.Trend is { } trend)
                                    {
                                        <span class="trend" title="@trend.Text">@trend.Arrow</span>
                                    }
                                </div>
                                @if (tile.Corner is { } corner)
                                {
                                    <span class="corner">@CaptionText(corner)</span>
                                }
                            </div>
                            <div class="label">@tile.Label</div>
                            @if (tile.Gauge is not null || tile.Caption is not null)
                            {
                                <div class="detail">
                                    @if (tile.Gauge is { } gauge)
                                    {
                                        <RangeGauge Current="@gauge.Current"
                                                    LowerBound="@gauge.LowerBound"
                                                    UpperBound="@gauge.UpperBound"
                                                    Range="@gauge.Range"
                                                    Limit="@gauge.Limit"
                                                    Marks="@gauge.Marks"
                                                    Warning="@tile.Over" />
                                    }
                                    else
                                    {
                                        <div class="gauge-placeholder"></div>
                                    }
                                    @if (tile.Caption is { } caption)
                                    {
                                        <div class="caption">
                                            <span>@CaptionText(caption.Left)</span>
                                            @if (tile.Alert is { } alert)
                                            {
                                                <span class="chip status-warning">@alert</span>
                                            }
                                            else
                                            {
                                                <span>@CaptionText(caption.Right)</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>

            <div class="main-column">
                <ProcessTable Processes="@snapshot.Processes"
                              TotalMemoryKb="@TotalMemoryKb"
                              CpuPercent="@Metrics.Cpu.Latest"
                              MemoryPercent="@Metrics.Memory.Latest"
                              MemoryFreePercent="@Metrics.MemoryFreePercent" />
            </div>

            <div class="side-column">
                <section class="panel" aria-label="@Text.Utilization">
                    <div class="panel-head">
                        <h2 class="panel-title">@Text.Utilization</h2>
                        <div class="head-info">
                            <span class="muted">@Text.LastTwoMinutes</span>
                            <StatusChip OverThreshold="@SystemOverThreshold" />
                        </div>
                    </div>
                    <div class="rows">
                        @foreach (var row in VisibleSystemRows())
                        {
                            <StatusRow @key="row.Title"
                                       Status="@ShownStatus(row)"
                                       ValueStatus="@row.Status"
                                       Title="@row.Title"
                                       Subtitle="@row.Subtitle"
                                       History="@row.History"
                                       Max="@row.Max"
                                       Limit="@row.Limit"
                                       Value="@row.Value"
                                       Tooltip="@row.Tooltip"
                                       Indented="@row.Indented"
                                       Bar="@row.Bar"
                                       Expanded="@(HasChildRows(row) ? _expandedGroups.Contains(row.Title) : null)"
                                       ReserveExpanderSpace="@(!row.Indented)"
                                       ClickLabel="@(HasChildRows(row) ? string.Format(CultureInfo.CurrentCulture, Text.ToggleDetails, row.Title) : null)"
                                       OnClick="@(HasChildRows(row) ? EventCallback.Factory.Create(this, () => ToggleGroup(row.Title)) : default)" />
                        }
                    </div>
                </section>

                <section class="panel" aria-label="@Text.Peaks">
                    <div class="panel-head">
                        <h2 class="panel-title">@Text.Peaks</h2>
                        <div class="head-info">
                            <span class="muted">@PeakSpanText</span>
                            @if (_peaks.Count > 0)
                            {
                                <span class="chip status-warning">@_peaks.Count</span>
                            }
                        </div>
                    </div>
                    <PeakChart Minutes="@_minutes" Peaks="@_peaks" Started="@DailyRanges.Started" OnPeakSelected="@OpenPeak" />
                    <div class="rows">
                        @if (_peaks.Count == 0)
                        {
                            <div class="empty-note">
                                <span class="dot status-normal"></span>
                                @{ var calm = CalmText; }
                                <span>@calm.Lead<b>@calm.Value</b>@calm.Tail</span>
                            </div>
                        }
                        @foreach (var peak in _peaks)
                        {
                            <StatusRow @key="(peak.Kind, peak.Start)"
                                       Status="@(peak.Throttled && peak.Kind == PeakKind.Temperature ? OverviewStatus.Failed : OverviewStatus.Warning)"
                                       Title="@($"{PeakText.Name(peak.Kind)} {PeakText.Value(peak.Kind, peak.PeakValue)}")"
                                       Subtitle="@PeakSubtitle(peak)"
                                       History="@s_noHistory"
                                       Max="1"
                                       Value="@LocalTime(peak.PeakTime)"
                                       ClickLabel="@string.Format(CultureInfo.CurrentCulture, Text.PeakDetails, PeakText.Name(peak.Kind))"
                                       OnClick="@(() => OpenPeak(peak))" />
                        }
                    </div>
                </section>
                <PeakDialog Peak="@_openPeak" RunningPids="@_runningPids" @bind-Visible="_peakDialogVisible" />
            </div>
        </div>
    }
</div>
