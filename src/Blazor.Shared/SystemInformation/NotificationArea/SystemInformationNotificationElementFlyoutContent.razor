@using DevExpress.Blazor
@using Blazor.Shared.SystemInformation.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Sdk.Authorization
@using Sdk.Client.Components.LinkButton
@using Sdk.Client.NotificationArea.Components.Layout
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@if (_authState != null)
{
    <NotificationElementFlyoutContentLayout>
        <Main>
            <div class="systeminfo-monitor">
                <div class="systeminfo-tabs">
                    <DxTabs>
                        <DxTabPage Text="@TwentyFourHoursLabel">
                            <SystemMonitoringComponent TimeSpanHours="24" />
                        </DxTabPage>
                        <DxTabPage Text="@OneHourLabel">
                            <SystemMonitoringComponent TimeSpanHours="1" />
                        </DxTabPage>
                    </DxTabs>
                </div>
                <AuthorizeView Policy="@ModulePolicyProvider.GetPolicy(Core.Shared.Constants.SystemModuleId, AccessLevel.Full, Constants.LogViewFeature)">
                    <Authorized>
                        <div class="systeminfo-open-monitor">
                            <LinkButton IconName="@MonochromeIconName.OpenInNewWindow"
                                        Text="@Localization.SystemInformationNotificationElementFlyoutContent.OpenMonitor"
                                        OnClick="@OpenMonitor" />
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <div class="systeminfo-log-center">
                <LogCenterComponent />
            </div>

            <div class="systeminfo-hw-sw">
                <SoftAndHardwareComponent />
            </div>
        </Main>

        <Footer>
            <AuthorizeView Policy="@SysAdminPolicy">
                <Authorized>
                    @*restart and shutdown section*@
                    <div class="restart-and-shutdown">
                        @*
                        05.06.2026: Shutdown is removed for now. It should either become a feature per deployment type,
                        or edgeS must get actual shutdown AND wake-on-lan functionality.
                        Set ".restart-and-shutdown.height" back to 118px, when re-enabled

                        <div>
                            <LinkButton IconName="@MonochromeIconName.SwitchOff"
                                        Text="@Localization.SystemInformationNotificationElementFlyoutContent.ShutdownSystem"
                                        OnClick="@(() => _shutdownDialogVisible = true)" />
                        </div>
                        *@
                        <div>
                            <LinkButton IconName="@MonochromeIconName.Refresh"
                                        Text="@Localization.SystemInformationNotificationElementFlyoutContent.RestartSystem"
                                        OnClick="@(() => _restartSystemDialogVisible = true)" />
                        </div>
                        <div>
                            <LinkButton IconName="@MonochromeIconName.Refresh"
                                        Text="@Localization.SystemInformationNotificationElementFlyoutContent.Restart"
                                        OnClick="@(() => _restartDialogVisible = true)" />
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </Footer>
    </NotificationElementFlyoutContentLayout>

    <ConfirmCancelDialog HeaderText="@Localization.SystemInformationNotificationElementFlyoutContent.RestartSystemDialogHeader"
                         OnConfirm="@RestartSystem"
                         @bind-Visible="_restartSystemDialogVisible">
        <Body>
            @Localization.SystemInformationNotificationElementFlyoutContent.RestartSystemDialogBody
        </Body>
    </ConfirmCancelDialog>

    <ConfirmCancelDialog HeaderText="@Blazor.Shared.Localization.RestartSuite.DialogHeader"
                         OnConfirm="@RestartSuite"
                         @bind-Visible="_restartDialogVisible">
        <Body>
            @Blazor.Shared.Localization.RestartSuite.DialogBody
        </Body>
    </ConfirmCancelDialog>

    <ConfirmCancelDialog HeaderText="@Localization.SystemInformationNotificationElementFlyoutContent.ShutdownSystemDialogHeader"
                         OnConfirm="@ShutdownSystem"
                         @bind-Visible="_shutdownDialogVisible">
        <Body>
            @Localization.SystemInformationNotificationElementFlyoutContent.ShutdownSystemDialogBody
        </Body>
    </ConfirmCancelDialog>
}
