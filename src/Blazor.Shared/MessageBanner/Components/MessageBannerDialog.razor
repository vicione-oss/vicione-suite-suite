@using Sdk.Client.Extensions
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@if (State.Visible)
{
    <div class="message-banner-dialog @State.Message.Type.ToString().ToHyphenSeparated()">
        <button class="minimize-button" @onclick="MinimizeButtonClick">
            <MonochromeIcon Name="MonochromeIconName.CloseCircleSolid" Size="MonochromeIconSize.SmallMedium" />
        </button>

        <div class="sign">
            <MonochromeIcon Name="@State.Message.Icon" Size="MonochromeIconSize.MediumLarge" />
        </div>

        <div class="wrapper">
            <div class="title">
                @State.Message.Title
            </div>
            <div class="description">
                @State.Message.Description
            </div>
        </div>
    </div>
}
