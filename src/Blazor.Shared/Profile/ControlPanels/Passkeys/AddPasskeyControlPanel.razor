@using Blazor.Shared.Services
@using Blazor.Shared.Profile.Localization
@using Core.Shared.Passkeys
@using Sdk.Authorization
@using Sdk.Client.ControlPanels.Attributes
@using ViciOne.Ui.Localization.Resources

@inherits ControlPanelBase<AddPasskeysControlPanelState>

@attribute [ControlPanelCategory<ProfileCategoryDescriptor>]
@attribute [ControlPanelGroup<SecondaryControlPanelGroupDescriptor>]
@attribute [ModuleAuthorize(SharedClientModule.ModuleId)]

@inject IJSRuntime JS
@implements IAsyncDisposable

<DescriptionBanner Title="@AddPasskey.AddPasskeyTitle">
    @AddPasskey.Description
</DescriptionBanner>

<SettingsLayout>
    <SettingsGroup Title="@CommonVocabulary.Common">
        <SettingsField Label="@CommonVocabulary.Name">
            <SettingsFieldTextBox
                Placeholder="@CommonVocabulary.Name"
                @bind-Value="@State.Name"
                @bind-Value:after="BeginEdit"
                Enabled="@(!MaxNumberOfPasskeysExceeded)"/>
        </SettingsField>
    </SettingsGroup>
</SettingsLayout>

@code {
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/Blazor.Shared/Profile/ControlPanels/Passkeys/AddPasskeyControlPanel.razor.js");
        }
    }

    private bool MaxNumberOfPasskeysExceeded => State.ExistingUserPasskeys is { Count: >= Constants.MaxPasskeyCount };

    public new async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Ignore errors if the circuit is already disconnected
            }
        }
    }

}
