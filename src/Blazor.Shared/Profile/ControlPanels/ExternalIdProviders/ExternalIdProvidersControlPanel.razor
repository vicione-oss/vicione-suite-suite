@using Blazor.Shared.Services
@using Blazor.Shared.Profile.Localization
@using Sdk.Authorization
@using Sdk.Client.Components.LinkButton
@using Sdk.Client.ControlPanels.Attributes
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@using ViciOne.Ui.MonochromeIcons.Core.Extensions

@inherits ControlPanelBase<ExternalIdProvidersControlPanelState>

@attribute [ControlPanelCategory<ProfileCategoryDescriptor>]
@attribute [ControlPanelGroup<SecondaryControlPanelGroupDescriptor>]
@attribute [ModuleAuthorize(SharedClientModule.ModuleId)]

<ControlPanelPage Title="@ExternalIdProviders.Title">
    <DescriptionBanner Title="@ExternalIdProviders.Title"
                       IconCssClass="@MonochromeIconName.ExternalIdProviderLight.GetCssClasses(MonochromeIconSize.Medium).ToSpaceSeparated()">
        @ExternalIdProviders.Description
    </DescriptionBanner>

    <SettingsLayout>
        <SettingsGroup Title="@CommonVocabulary.Common">
            @if (!State.IsExternalAuthenticationProviderConfigured)
            {
                <SettingsField Label="@CommonVocabulary.Status">
                    <span>@ExternalIdProviders.NoProviderConfigured</span>
                </SettingsField>
            }
            else if (State.LinkedExternalAccount is null)
            {
                <SettingsField Label="@CommonVocabulary.Status">
                    <span>@ExternalIdProviders.NoLinkedAccount</span>
                </SettingsField>
                <SettingsField>
                    <AddExternalIdProviderButton ExternalIdProvider="OpenIdConnect" />
                </SettingsField>
            }
            else
            {
                <SettingsField Label="@ExternalIdProviders.LinkedAccount">
                    <span>@(State.LinkedExternalAccount.DisplayName ?? State.LinkedExternalAccount.LoginProvider)</span>
                </SettingsField>
                <SettingsField>
                    <LinkButton IconName="@MonochromeIconName.Delete"
                                Text="@ExternalIdProviders.UnlinkAccount"
                                OnClick="@OpenUnlinkConfirmation" />
                </SettingsField>
            }

            @if (!string.IsNullOrEmpty(State.RemovalError))
            {
                <SettingsInformation>
                    @State.RemovalError
                </SettingsInformation>
            }
        </SettingsGroup>
    </SettingsLayout>
</ControlPanelPage>

<ConfirmCancelDialog HeaderText="@ExternalIdProviders.UnlinkAccount"
                     OnConfirm="@ConfirmUnlinkAccount"
                     @bind-Visible="_unlinkDialogVisible">
    <Body>
        @ExternalIdProviders.UnlinkConfirmationBody
    </Body>
</ConfirmCancelDialog>
