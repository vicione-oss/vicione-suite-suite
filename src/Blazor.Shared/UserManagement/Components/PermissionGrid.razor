@using Blazor.Shared.Settings.Components
@using Blazor.Shared.UserManagement.Models
@using Microsoft.AspNetCore.Components.Forms
@using ViciOne.Ui.Blazor.Components.Grid.Components
@using ViciOne.Ui.Blazor.Components.Grid.Components.Columns
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<div class="permisson-grid-container">
    <LimitedHeightLayout>
        <Grid Items="Items" Virtualize="true" CssClass="permission-grid">
            <Filter>
                <GridFilterControl Text="@Filter"
                                   TextChanged="@FilterChanged"/>
            </Filter>

            <ChildContent>
                <TemplateColumn Title="@CommonVocabulary.Name">
                    <div class="name-container">
                        @if (context.IsGroupingRow)
                        {
                            <div class="group-name">
                                <MonochromeIcon Name="MonochromeIconName.KeychainLight" Size="MonochromeIconSize.SmallMedium"/>
                                <span>@context.ModuleId</span>
                            </div>
                        }
                        else
                        {
                            <div>
                                <MonochromeIcon Name="MonochromeIconName.KeyLight" Size="MonochromeIconSize.SmallMedium"/>
                                <span>@context.Feature</span>
                            </div>
                        }
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="@CommonVocabulary.Description">
                    @context.Description
                </TemplateColumn>

                <TemplateColumn Title="@Localization.PermissionGrid.AccessLevelAbbreviation">
                    <HeaderTemplate>
                        <div class="access-level-container header">
                            <span>@Localization.PermissionGrid.AccessLevelAbbreviation</span>
                            <div>
                                <MonochromeIcon Name="MonochromeIconName.PermissionNone" Size="MonochromeIconSize.Small"/>
                                <MonochromeIcon Name="MonochromeIconName.PermissionViewOnly" Size="MonochromeIconSize.Small"/>
                                <MonochromeIcon Name="MonochromeIconName.PermissionViewAndEdit" Size="MonochromeIconSize.Small"/>
                            </div>
                        </div>
                    </HeaderTemplate>

                    <ChildContent>
                        <div class="access-level-container">
                            <span></span>
                            <div>
                                @if (!context.IsGroupingRow)
                                {
                                    <InputRadioGroup @bind-Value="@context.AccessLevel"
                                                     @bind-Value:after="@(async () => await AccessLevelChanged.InvokeAsync(context))"
                                                     DisplayName="@(context.AccessLevel.ToString())"
                                                     Name="@(context.ModuleId + context.Feature)">

                                        <InputRadio Value="@(PermissionGridAccessLevel.None)" disabled="@Disabled" />

                                        <InputRadio Value="@(PermissionGridAccessLevel.Partial)" disabled="@Disabled" />

                                        <InputRadio Value="@(PermissionGridAccessLevel.Full)" disabled="@Disabled" />
                                    </InputRadioGroup>
                                }
                            </div>
                        </div>
                    </ChildContent>
                </TemplateColumn>
            </ChildContent>
        </Grid>
    </LimitedHeightLayout>
</div>
