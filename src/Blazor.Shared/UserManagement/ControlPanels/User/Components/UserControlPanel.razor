@using Blazor.Shared.Localization
@using Blazor.Shared.UserManagement.ControlPanels.User.Services
@using Labels = Blazor.Shared.UserManagement.Localization.Labels;
@using Sdk.Client.Components.Settings.Expanders
@using ViciOne.Ui.Localization.Resources

@inherits ControlPanelBase<UserControlPanelState>

<ControlPanelPage Title="@Localization.UserControlPanel.Info">
    <DescriptionBanner Title="@GetDescriptionBannerTitle()">
        @GetDescriptionBannerContent()
    </DescriptionBanner>

    <SettingsLayout>
        @if (State.UserProfile is not null)
        {
            <SettingsGroup Title="@CommonVocabulary.User" @bind-Expanded="@State.UserSettingsGroupExpanded">
                <SettingsField Label="@TechnicalTerms.Username">
                    <SettingsFieldTextBox Placeholder="@TechnicalTerms.Username" Enabled="@(!State.IsEditMode())" Value="@State.UserProfile.UserName.Value" ValueChanged="UserNameTextBoxValueChanged" />
                </SettingsField>

                <SettingsField Label="@CommonVocabulary.FirstName">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Name" @bind-Value="@State.UserProfile.Firstname" @bind-Value:after="BeginEdit" />
                </SettingsField>

                <SettingsField Label="@CommonVocabulary.Surname">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Surname" @bind-Value="@State.UserProfile.Lastname" @bind-Value:after="BeginEdit" />
                </SettingsField>

                <SettingsField Label="@CommonVocabulary.Title">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Title" @bind-Value="@State.UserProfile.Title" @bind-Value:after="BeginEdit" />
                </SettingsField>

                <SettingsField Label="@Localization.UserControlPanel.PasswordExpirationDate">
                    <SettingsFieldTextBox Placeholder="@User.Localization.Constants.UniversalDateFormat" @bind-Value="@State.PasswordExpirationDateString" @bind-Value:after="BeginEdit" />
                </SettingsField>
            </SettingsGroup>

            <SettingsGroup Title="@CommonVocabulary.Contact" @bind-Expanded="@State.ContactSettingsGroupExpanded">
                <SettingsField Label="@CommonVocabulary.Email">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Email" @bind-Value="@State.UserProfile.Email" @bind-Value:after="BeginEdit" />
                </SettingsField>

                <SettingsField Label="@CommonVocabulary.Cellphone">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Cellphone" @bind-Value="@State.UserProfile.Mobile" @bind-Value:after="BeginEdit" />
                </SettingsField>

                <SettingsField Label="@CommonVocabulary.Phone">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Phone" @bind-Value="@State.UserProfile.PhoneNumber" @bind-Value:after="BeginEdit" />
                </SettingsField>
            </SettingsGroup>

            <SettingsGroup Title="@CommonVocabulary.Password" @bind-Expanded="@State.PasswordSettingsGroupExpanded">
                @if (_selfEdit)
                {
                    <SettingsField Label="@Labels.CurrentPassword">
                        <SettingsFieldTextBox Placeholder="@Labels.CurrentPassword" Password="true" @bind-Value="@State.CurrentPassword" @bind-Value:after="BeginEdit" />
                    </SettingsField>
                }

                <SettingsField Label="@Labels.NewPassword">
                    <SettingsFieldTextBox Placeholder="@Labels.NewPassword" Password="true" @bind-Value="@State.NewPassword" @bind-Value:after="BeginEdit" />
                </SettingsField>

                <SettingsField Label="@Labels.RepeatNewPassword">
                    <SettingsFieldTextBox Placeholder="@Labels.RepeatNewPassword" Password="true" @bind-Value="@State.RepeatNewPassword" @bind-Value:after="BeginEdit" />
                </SettingsField>
            </SettingsGroup>

            <SettingsGroup Title="@Localization.UserControlPanel.ActiveTwoFactorAuthentification" Expanded="@_twoFactorAuthenticationEnabled">
                <Expander>
                    <SwitchExpander Enabled="false" @bind-Value="@_twoFactorAuthenticationEnabled" @bind-Value:after="BeginEdit" />
                </Expander>

                <ChildContent>
                </ChildContent>
            </SettingsGroup>

            <SettingsGroup Title="@CommonVocabulary.Company" @bind-Expanded="@State.CompanySettingsGroupExpanded">
                @*
                <SettingsField Label="@CommonVocabulary.Company">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Company" Enabled="false" />
                </SettingsField>
                <SettingsField Label="@CommonVocabulary.Site">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Site" Enabled="false" />
                </SettingsField>
                *@
                <SettingsField Label="@CommonVocabulary.Department">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Department" @bind-Value="@State.UserProfile.Department" @bind-Value:after="BeginEdit" />
                </SettingsField>
                <SettingsField Label="@CommonVocabulary.Occupation">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Occupation" @bind-Value="@State.UserProfile.Occupation" @bind-Value:after="BeginEdit" />
                </SettingsField>
                @*
                <SettingsField Label="@Localization.UserControlPanel.ReportsTo">
                    <SettingsFieldTextBox Placeholder="@Localization.UserControlPanel.ReportsTo" Enabled="false" />
                </SettingsField>
                <SettingsField Label="@CommonVocabulary.Representative">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Representative" Enabled="false" />
                </SettingsField>
                *@
            </SettingsGroup>

            <SettingsGroup Title="@CommonVocabulary.Localization" @bind-Expanded="@State.LocalizationSettingsGroupExpanded">
                <SettingsField Label="@CommonVocabulary.Language">
                    <SettingsFieldTextBox ReadOnly="true" Value="@(State.SelectedCulture?.DisplayName ?? CommonVocabulary.Default)" />
                    @* <SettingsFieldCultureComboBox Items="@Constants.SupportedCultures" @bind-Value="@State.SelectedCulture" @bind-Value:after="BeginEdit"/> *@
                </SettingsField>
                <SettingsField Label="@CommonVocabulary.TimeZone">
                    <SettingsFieldTextBox ReadOnly="true" Value="@(State.SelectedTimeZone?.DisplayName ?? CommonVocabulary.Default)" />
                </SettingsField>
            </SettingsGroup>
        }
    </SettingsLayout>
</ControlPanelPage>

<UserRolesControlPanelPage State="State" OnEdit="BeginEdit" />

