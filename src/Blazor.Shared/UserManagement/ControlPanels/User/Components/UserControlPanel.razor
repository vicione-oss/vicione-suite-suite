<ControlPanelPage Title="@TechnicalTerms.PermissionPlural">
    <DescriptionBanner Title="@(string.Format(Localization.UserControlPanel.PermissionsDescriptionBannerTitle, State.UserName))">
        @Localization.UserControlPanel.PermissionsDescriptionBannerContent
    </DescriptionBanner>

    <Grid Items="@State.FilteredGridItems">
        <Filter>
            <GridFilterControl @bind-Text="@State.FilterText"
                               @bind-Text:after="@State.UpdateGridItems" />
        </Filter>

        <ChildContent>
            <TemplateColumn Title="@CommonVocabulary.Name">
                <div class="name-container">
                    @if (context.IsGroupingRow)
                    {
                        <div class="group-name">
                            <MonochromeIcon Name="MonochromeIconName.KeychainLight" Size="MonochromeIconSize.SmallMedium"/>
                            <span>@context.ModuleId</span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <MonochromeIcon Name="MonochromeIconName.KeyLight" Size="MonochromeIconSize.SmallMedium"/>
                            <span>@context.Feature</span>
                        </div>
                    }
                </div>
            </TemplateColumn>

            <TemplateColumn Title="@CommonVocabulary.Description">
                @context.Description
            </TemplateColumn>

            <TemplateColumn Title="@Localization.UserControlPanel.AccessLevel">
                <HeaderTemplate>
                    <div class="access-level-container header">
                        <span>@Localization.UserControlPanel.AccessLevel</span>
                        <div>
                            <MonochromeIcon Name="MonochromeIconName.PermissionNone" Size="MonochromeIconSize.Small"/>
                            <MonochromeIcon Name="MonochromeIconName.PermissionViewOnly" Size="MonochromeIconSize.Small"/>
                            <MonochromeIcon Name="MonochromeIconName.PermissionViewAndEdit" Size="MonochromeIconSize.Small"/>
                        </div>
                    </div>
                </HeaderTemplate>

                <ChildContent>
                    <div class="access-level-container">
                        <span></span>
                        <div>
                            @if (!context.IsGroupingRow)
                            {
                                <InputRadioGroup @bind-Value="@context.AccessLevel"
                                                 @bind-Value:after="@(async () => await AccessLevelChangedAsync(context))"
                                                 DisplayName="@(context.AccessLevel.ToString())"
                                                 Name="@(context.ModuleId + context.Feature)">

                                    <InputRadio Value="@(PermissionGridAccessLevel.None)" />

                                    <InputRadio Value="@(PermissionGridAccessLevel.Partial)" />

                                    <InputRadio Value="@(PermissionGridAccessLevel.Full)" />
                                </InputRadioGroup>
                            }
                        </div>
                    </div>
                </ChildContent>
            </TemplateColumn>
        </ChildContent>
    </Grid>
</ControlPanelPage>

