@using Blazor.Shared.UserManagement.ControlPanels.Role.Services
@using ViciOne.Ui.Localization.Resources

@inherits ControlPanelBase<RoleControlPanelState>

<DescriptionBanner Title="@GetDescriptionBannerTitle()">
    @GetDescriptionBannerContent()
</DescriptionBanner>

<SettingsLayout>
    @if (State.Role is not null)
    {
        <SettingsGroup Title="@CommonVocabulary.Role" @bind-Expanded="@State.RoleSettingsGroupExpanded">
            <SettingsField Label="@CommonVocabulary.Name">
                <SettingsFieldTextBox Placeholder="@CommonVocabulary.Name" Enabled="@(!State.IsEditMode)" Value="@State.Role.Name" ValueChanged="RoleNameTextBoxValueChanged" />
            </SettingsField>

            <SettingsField Label="@CommonVocabulary.Description">
                <SettingsFieldTextBox Placeholder="@CommonVocabulary.Description" Enabled="@(!State.Role.Managed)" @bind-Value="@State.Role.Description" @bind-Value:after="BeginEdit" />
            </SettingsField>
        </SettingsGroup>
    }
</SettingsLayout>
