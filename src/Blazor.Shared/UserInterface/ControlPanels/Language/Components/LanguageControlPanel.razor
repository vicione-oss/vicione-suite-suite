@using Blazor.Shared.Settings.Components
@using Blazor.Shared.UserInterface.ControlPanels.Language.Services
@using ViciOne.Ui.Localization.Resources

@inherits ControlPanelBase<LanguageControlPanelState>

<ControlPanelPage Title="@TechnicalTerms.SystemDefault">
    <DescriptionBanner Title="@CommonVocabulary.Language" IconCssClass="@_languageIconCssClasses">
        @Localization.LanguageControlPanel.DescriptionBannerContent
    </DescriptionBanner>

    <SettingsLayout>
        <SettingsGroup Title="@TechnicalTerms.DisplayLanguage">
            <SettingsField Label="@CommonVocabulary.Language">
                <SettingsFieldCultureComboBox Items="@Constants.SupportedCultures" @bind-Value="@State.SelectedCulture" @bind-Value:after="AfterSelectedCultureChange" />
            </SettingsField>

            @* Shown only after a language change *@
            <InformationBannerSettingsField Text="@Localization.LanguageControlPanel.LanguageChangeSavedBannerText" Visible="@State.ShowPageRefreshInformation">
                <Button>
                    <SettingsFieldButton IconCssClass="@_refreshIconCssClasses" Text="@CommonVocabulary.RefreshVerb" OnClick="RefreshButtonClick" />
                </Button>
            </InformationBannerSettingsField>

            @* Shown only when the change does not affect the current user *@
            <InformationBannerSettingsField Text="@Localization.LanguageControlPanel.LanguageChangeDoesNotAffectUser" Visible="@State.ShowLanguageDoesNotAffectCurrentUser" />
        </SettingsGroup>
    </SettingsLayout>
</ControlPanelPage>
