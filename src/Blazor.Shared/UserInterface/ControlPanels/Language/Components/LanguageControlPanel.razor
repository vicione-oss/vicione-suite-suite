@using Blazor.Shared.Settings.Components
@using Blazor.Shared.UserInterface.ControlPanels.Language.Services
@using ViciOne.Ui.Localization.Resources

@inherits ControlPanelBase<LanguageControlPanelState>

<ControlPanelPage Title="@TechnicalTerms.SystemDefault">
    <DescriptionBanner Title="@CommonVocabulary.Language" IconCssClass="@_languageIconCssClasses">
        @Localization.SystemDefaultControlPanelPage.DescriptionBannerContent
    </DescriptionBanner>

    <SettingsLayout>
        <SettingsGroup Title="@TechnicalTerms.DisplayLanguage">
            <SettingsField Label="@CommonVocabulary.Language" IsLoading="@State.SelectedCultureLoading" LoadingIndication="SettingsFieldLoadingIndication.Spinner">
                <SettingsFieldCultureComboBox Items="@Constants.SupportedCultures" @bind-Value="@State.SelectedCulture" @bind-Value:after="BeginEdit" />
            </SettingsField>

            <InformationBannerSettingsField Text="@Localization.SystemDefaultControlPanelPage.LanguageChangeSavedBannerText" Visible="@State.ShowLanguageSavedBanner">
                <Button>
                    <SettingsFieldButton IconCssClass="@_refreshIconCssClasses" Text="@CommonVocabulary.RefreshVerb" OnClick="RefreshButtonClick" />
                </Button>
            </InformationBannerSettingsField>
        </SettingsGroup>
    </SettingsLayout>
</ControlPanelPage>
