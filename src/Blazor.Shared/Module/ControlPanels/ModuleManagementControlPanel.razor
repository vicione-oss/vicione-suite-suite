@using Blazor.Shared.Module.ControlPanels.Services
@using Blazor.Shared.Module.Models
@using Blazor.Shared.Module.Services
@using Blazor.Shared.Module.ControlPanels.Extensions;
@using Microsoft.AspNetCore.Components.Authorization
@using Sdk.Client.Components.Settings.Expanders
@using ViciOne.Ui.Blazor.Components.ComboBox
@using ViciOne.Ui.Blazor.Components.Grid.Components
@using ViciOne.Ui.Blazor.Components.Grid.Components.ActionButtons
@using ViciOne.Ui.Blazor.Components.Grid.Components.Columns
@using ViciOne.Ui.Blazor.Components.Grid.Components.Footers
@using ViciOne.Ui.Blazor.Components.Grid.Models
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.Blazor.Components.CheckBox
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@using ViciOne.Ui.MonochromeIcons.Core.Extensions

@inherits ControlPanelBase<ModuleManagementControlPanelState>

<ControlPanelPage Title="@CommonVocabulary.Installed">
    <div class="installed-modules-control-panel-page">
        <DescriptionBanner Title="@Localization.ModuleManagementControlPanel.InstalledModules">
            @Localization.ModuleManagementControlPanel.InstalledModulesBanner
        </DescriptionBanner>

        <Grid Items="@FilterInstalledItems(State.InstalledModules)" Virtualize="true" CssClass="installed-modules-grid">
            <ActionButtons>
                <div style="display:contents;">
                    <GridActionButton Text="@CommonVocabulary.UninstallVerb"
                                      OnClick="@(async () => await UninstallSelectedModules())"
                                      IconCssClass="@_uninstallIconCssClasses"
                                      Enabled="@CanUninstallSelectedModules()" />
                    
                    <GridActionButton Text="@CommonVocabulary.ResetVerb"
                                      OnClick="@(async () => await ResetInstalledSelectedModules())"
                                      IconCssClass="@_uninstallIconCssClasses"
                                      Enabled="@CanResetInstalledSelectedModules()" />

                    <GridActionButton Text="@CommonVocabulary.Restart"
                                      OnClick="@(() => _dialogVisible = true)"
                                      IconCssClass="@_restartIconCssClasses" />
                </div>
            </ActionButtons>

            <Filter>
                <GridFilterControl @bind-Text="@State.InstalledFilterText" @bind-Text:after="@(() => InvokeAsync(StateHasChanged))" />
            </Filter>

            <ChildContent>
                <ItemSelectColumn KeySelector="@(item => item)"
                                  Selection="@InstalledModuleSelection" />

                <PropertyColumn Title="@CommonVocabulary.Name"
                                Property="@(i => i.Name)"
                                Sortable="true" />
                
                <TemplateColumn Title="@LibraryManagement.InstalledVersion">
                    <div class="version-wrapper">
                        <div class="version" title="@context.Version">
                            @context.Version
                        </div>
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="@CommonVocabulary.Status">
                    <div class="status-wrapper">
                        @if (context.PendingOperation is not null)
                        {
                            @if (context.PendingOperation.OperationKind is Core.Shared.Modules.Contracts.ModulePackageOperationKind.Uninstall)
                            {
                                <div title="@LibraryManagement.PendingUninstallation" class="icon-wrapper">
                                    <MonochromeIcon Name="MonochromeIconName.UninstallPendingLight" Size="MonochromeIconSize.SmallMedium" />
                                </div>
                            }
                            else if (context.PendingOperation.OperationKind is Core.Shared.Modules.Contracts.ModulePackageOperationKind.Install)
                            {
                                <div title="@context.GetInstallOrUpdateTooltip()" class="icon-wrapper">
                                    <MonochromeIcon Name="MonochromeIconName.InstallPendingLight" Size="MonochromeIconSize.SmallMedium" />
                                </div>
                            }
                        }

                        @if (context.Bundle.IsDebugSource)
                        {                            
                            <div title="@Localization.ModuleManagementControlPanel.ModuleLoadedFromDebugPath" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.BugLight" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        }
                        
                        @if (context.CanUpdate)
                        {
                            <div title="@context.GetUpdateAvailableTooltip()" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.UpdateAvailableLight" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        }

                        @if (context.HasError)
                        {                            
                            <div title="@context.GetErrorTooltip()" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.ErrorSolid" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        }
                    </div>
                </TemplateColumn>

                <NavigationColumn NavigationButtonTitle="@CommonVocabulary.EditVerb"
                                  Navigate="@((ModuleMetadataModel model) => ShowDetailsAsync(model))" />
            </ChildContent>

            <Footer>
                <SelectionFooter GridSelection="@InstalledModuleSelection" />
            </Footer>
        </Grid>
    </div>
</ControlPanelPage>

<ControlPanelPage Title="@CommonVocabulary.BrowseVerb">
    
    <div class="available-modules-control-panel-page">
        <DescriptionBanner Title="@Localization.ModuleManagementControlPanel.BrowseModules">
            @Localization.ModuleManagementControlPanel.BrowseModulesBanner
        </DescriptionBanner>
    
        <Grid Items="@FilterAvailableItems(State.AvailableModules)" Virtualize="true" CssClass="available-modules-grid">
            <ActionButtons>
                <div style="display:contents;">                    
                    <GridActionButton Text="@CommonVocabulary.InstallVerb"
                                      OnClick="InstallSelectedAvailableModules"
                                      IconCssClass="@_installIconCssClasses"
                                      Enabled="@CanInstallSelectedAvailableModules()" />

                    <GridActionButton Text="@CommonVocabulary.ResetVerb"
                                      OnClick="@(async () => await ResetAvailableSelectedModules())"
                                      IconCssClass="@_uninstallIconCssClasses"
                                      Enabled="@CanResetAvailableSelectedModules()" />

                    <GridActionButton Text="@CommonVocabulary.RefreshVerb"
                                      OnClick="@(async () => await LoadAvailableModuleVersions(true))"
                                      IconCssClass="@_reloadIconCssClasses"
                                      Enabled="@(!State.IsLoading)"/>

                    <GridActionButton Text="@CommonVocabulary.Restart"
                                      OnClick="@(() => _dialogVisible = true)"
                                      IconCssClass="@_restartIconCssClasses" />
                </div>
            </ActionButtons>

            <Filter>
                <GridFilterControl @bind-Text="@State.AvailableFilterText" @bind-Text:after="@(() => InvokeAsync(StateHasChanged))" />
            </Filter>

            <ChildContent>
                <ItemSelectColumn KeySelector="@(item => item)"
                                  Selection="@AvailableModuleSelection" />

                <PropertyColumn Title="@CommonVocabulary.Name"
                                Property="@(i => i.Name)"
                                Sortable="true" />

                <PropertyColumn Title="@Localization.ModuleManagementControlPanel.LatestVersion"
                                Property="@(i => i.LatestVersion)" />

                <TemplateColumn Title="@CommonVocabulary.Status">
                    <div class="status-wrapper">
                            
                        @if (context.PendingOperation is not null)
                        {
                            @if (context.PendingOperation.OperationKind is Core.Shared.Modules.Contracts.ModulePackageOperationKind.Install)
                            {
                                <div title="@context.GetInstallOrUpdateTooltip()" class="icon-wrapper">
                                    <MonochromeIcon Name="MonochromeIconName.InstallPendingLight" Size="MonochromeIconSize.SmallMedium" />
                                </div>
                            }
                        }

                        @if (context.MissingDependencies.Count > 0)
                        {
                            <div title="@context.GetMissingDependenciesTooltip()" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.InfoOutlined" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        }
                    </div>
                </TemplateColumn>

                <NavigationColumn NavigationButtonTitle="@CommonVocabulary.EditVerb"
                                  Navigate="@((ModuleMetadataModel model) => ShowDetailsAsync(model))" />
            </ChildContent>

            <Footer>
                <SelectionFooter GridSelection="@AvailableModuleSelection" />
            </Footer>
        </Grid>

        <SettingsLayout>
            @if (State.RequestErrorCode > 0)
            {
                <SettingsGroup Title="@Localization.ModuleManagementControlPanel.ModuleApiError">
                    <SettingsInformation>
                        @State.RequestErrorMessage
                    </SettingsInformation>
                </SettingsGroup>
            }            
        </SettingsLayout>
    </div>
</ControlPanelPage>

<ConfirmCancelDialog Show="_dialogVisible"
                     HeaderText="@Blazor.Shared.Localization.RestartSuite.DialogHeader"
                     OnConfirm="@(async () => await RestartSuite())"
                     OnCancel="@(() => _dialogVisible = false)">
    <Body>
        @Blazor.Shared.Localization.RestartSuite.DialogBody
    </Body>
</ConfirmCancelDialog>
