@using Blazor.Shared.Mqtt.Contracts
@using Blazor.Shared.Mqtt.Extensions
@using Microsoft.AspNetCore.Components.QuickGrid
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Grid.Components
@using ViciOne.Ui.Localization.Resources

<div class="mqtt-messages mx-3">
    <div class="headline-container ms-2 mt-2">
        <h4>@GetHeadline()</h4>
    </div>

    @if (ViewerService.CurrentFilter == MqttFilterTypes.TopicNode)
    {
        <div class="mqtt-rel-container mqtt-filtered ms-2">
            <div class="mqtt-abs-container">
                <Grid Items="@ViewerService.GetMessagesByNodeFilter()"
                      CssClass="mqtt-grid alternating-rows">
                    
                    <ChildContent>
                        <TemplateColumn Title="@nameof(MessageModel.Topic)"
                                        Sortable="true">
                            <div class="grid-row-message">@context.GetRowTopic(ViewerService)</div>
                        </TemplateColumn>
                        
                        <PropertyColumn Title="@nameof(MessageModel.Message)"
                                        Property="@(m => m.Message)"
                                        Sortable="true" />
                        
                        <PropertyColumn Title="Counter"
                                        Property="@(m => m.MessageCount)"
                                        Align="Align.Left"
                                        Sortable="true" />
                        
                        <PropertyColumn Title="@nameof(MessageModel.Timestamp)"
                                        Property="@(m => m.Timestamp)"
                                        Format="dd.MM.yyyy hh:mm:ss"
                                        Sortable="true" />
                        
                        <TemplateColumn Title="@CommonVocabulary.Action">
                            <Button Title="Details" CssClass="details-btn"
                                    OnClick="@(async () => await ViewerService.ShowMessageDetails(context))">
                            </Button>
                        </TemplateColumn>
                    </ChildContent>
                </Grid>
            </div>
        </div>
    }
    else
    {
        <div class="mqtt-rel-container mqtt-all">
            <div class="mqtt-abs-container">
                <Grid Items="@ViewerService.GetMessagesByTextFilter()" CssClass="mqtt-grid alternating-rows">
                    <ChildContent>
                        <TemplateColumn Title="@CommonVocabulary.Action">
                            <div class="mqtt-row">
                                @* first row *@
                                <div class="mqtt-row-message">@("Topic: " + context?.Topic)</div>
                                <div class="mqtt-row-cell">
                                    @if (context?.Retained == true)
                                    {
                                        <div class="me-4">Retained</div>
                                    }
                                    <div class="me-4">@(context?.Timestamp.ToString("dd.MM.yyyy hh:mm:ss"))</div>
                                    <div>@("QoS: " + Convert.ToInt32(context?.Qos))</div>
                                </div>
                                @* second row *@
                                <div class="grid-row-message me-4">@(context?.Message)</div>
                                <div>@(context?.MessageId)</div>
                            </div>
                        </TemplateColumn>
                    </ChildContent>
                </Grid>
            </div>
        </div>
    }
</div>
