@using DevExpress.Blazor
@using Sdk.Authorization
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.ComboBox
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@using ViciOne.Ui.MonochromeIcons.Core.Extensions

@attribute [ModuleAuthorize(SharedClientModule.ModuleId, AccessLevel.Full)]

<div class="mqtt-viewer">
    <div class="mqtt-toolbar">
        <Toolbar>
            <ToolbarGroup>
                <ToolbarButton Text="@GetLifetimeInfo()"
                                 Enabled="false"/>
            </ToolbarGroup>

            <ToolbarGroup AlignRight>
                <!-- CONNECTION -->
                <ToolbarButton Text="@Localization.MqttViewer.BrokerConnection" Enabled="false"/>

                <ToolbarContent>
                    <ComboBox Items="@_connections"
                              @bind-Value="_selectedConnection"
                              TextSelector="@(connection => connection.Name ?? connection.Id.ToString())"
                              CssClass="connections-cbo"/>
                </ToolbarContent>

                <ToolbarContent>
                    <Button Title="@_toggleConnectionButtonTitle"
                            OnClick="@ToggleConnection"
                            IconCssClass="@_toggleConnectionButtonIconCssClass"
                            CssClass="_toggleConnectionButtonCssClass"
                            Enabled="@(!_isConnecting)"
                            Size="@ToggleConnectionButtonSize">
                    </Button>
                    
                </ToolbarContent>
            </ToolbarGroup>

            <ToolbarGroup AlignRight>
                <!-- REFRESH OPTIONS -->
                <ToolbarButton Text="@Localization.MqttViewer.ReloadInterval" Enabled="false"/>

                <ToolbarContent>
                    <div class="refresh-box">
                        <ComboBox Items="@_reloadIntervals"
                                  Value="_selectedReloadInterval"
                                  ValueChanged="@((int i) => ReloadIntervalChanged(i))"/>
                        <label>ms</label>
                    </div>
                </ToolbarContent>
            </ToolbarGroup>
        </Toolbar>
    </div>
    <div class="mqtt-content">
        <div class="list">
            <MqttMessagesComponent />
        </div>

        @if (ViewerService.DisplayMessageDetails)
        {
            <div class="message ms-4 me-3 my-3">
                <div class="headline-and-close-button">
                    <h4 class="headline">@Localization.MqttViewer.MessageDetails</h4>

                    <Button IconCssClass="@MonochromeIconName.CloseMedium.GetCssClasses(MonochromeIconSize.Medium).ToSpaceSeparated()"
                    		Size="ButtonSize.Medium"
                            OnClick="@ViewerService.CloseMessageDetails">
                    </Button>
                </div>

                <pre class="message-details">
                    @ViewerService.GetMessageDetails()
                </pre>
            </div>
        }

        <div class="filter">
            <MqttFilterComponent />
        </div>
    </div>

</div>

<OkDialog HeaderText="@Localization.MqttViewer.ErrorHeader"
          Visible="@(!string.IsNullOrEmpty(ViewerService.ErrorMessage))"
          OnConfirm="@(() => ViewerService.ErrorMessage = string.Empty)">
    <Body>
        @ViewerService.ErrorMessage
    </Body>
</OkDialog>
