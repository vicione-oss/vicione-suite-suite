@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Localization.Resources

<Dialog CssClass="@CssClass"
        HeaderText="@HeaderText"
        Height="35%"
        Width="35%"
        OnClosing="@OnConfirm"
        @bind-Visible:get="Visible"
        @bind-Visible:set="UpdateVisible">

    <Body>
        <DialogBodyTextLayout>
            @Body
        </DialogBodyTextLayout>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@OkButtonClick"
                            Text="@CommonVocabulary.Ok" />
    </Footer>
</Dialog>
