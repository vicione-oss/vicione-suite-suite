@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Localization.Resources

<Dialog CssClass="confirm-cancel-dialog"
        HeaderText="@HeaderText"
        Height="300px"
        Width="600px"
        OnClosing="@DialogClosing"
        @bind-Visible:get="_visible"
        @bind-Visible:set="UpdateVisible">

    <Body>
        <DialogBodyTextLayout>
            @Body
        </DialogBodyTextLayout>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@ConfirmButtonClick"
                            Text="@CommonVocabulary.Confirm" />

        <DialogFooterButton OnClick="@CancelButtonClick"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>
