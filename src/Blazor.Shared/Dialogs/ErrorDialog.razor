@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Localization.Resources

<OkDialog CssClass="error-dialog"
          HeaderText="@Localization.ErrorDialog.HeaderText"
          OnConfirm="@OnConfirm"
          @bind-Visible="@Visible"
          @bind-Visible:after="OkDialogChanged">

    <Body>
        @if (IsDebugEnabled && Exception != null)
        {
            <section>
                <h5>@TechnicalTerms.Type</h5>
                <p>@Exception.GetType().ToString()</p>
            </section>

            <section>
                <h5>@CommonVocabulary.Message</h5>
                <p>@Exception.Message</p>
            </section>
        }
        else
        {
            @Localization.ErrorDialog.ErrorText
        }
    </Body>
</OkDialog>
