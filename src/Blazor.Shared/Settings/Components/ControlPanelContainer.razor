@using Microsoft.AspNetCore.Components.Sections
@using Sdk.Client.ControlPanels.Services
@using ViciOne.Ui.Blazor.Components.ContentLoadingIndication
@using ViciOne.Ui.Blazor.Components.ContentLoadingIndication.Enums

@{
    if (_controlPanelState is null)
        return;

    var containerCssClasses = new List<string>
    {
        "control-panel-container"
    };

    if (_controlPanelState.IsLoading)
        containerCssClasses.Add("loading");
}

<div class="@string.Join(" ", containerCssClasses)">
    <CascadingValue Value="ControlPanelRegistryItem">
        <DynamicComponent Type="@ControlPanelRegistryItem.ComponentType" Parameters="@_controlPanelParameters" @key="ControlPanelRegistryItem" />
    </CascadingValue>

    <div class="spacer" />
</div>

@if (_controlPanelState.IsLoading)
{
    <SectionContent SectionId="@LoadingIndicationSectionId">
        <div class="content-loading-indication-container">
            <ContentLoadingIndication Visible="@_controlPanelState.IsLoading" Kind="@LoadingIndicationKind.SpinnerCenter">
                &nbsp;
            </ContentLoadingIndication>
        </div>
    </SectionContent>
}
