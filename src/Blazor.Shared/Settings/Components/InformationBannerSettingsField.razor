@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@if (Visible)
{
    <SettingsField>
        <div class="information-banner-settings-field-content">
            <div class="icon">
                <MonochromeIcon Name="MonochromeIconName.InfoOutlined" Size="MonochromeIconSize.SmallMedium" />
            </div>

            <div class="text">
                @Text
            </div>

            @if (Button is not null)
            {
                <div class="button">
                    @Button
                </div>
            }
        </div>
    </SettingsField>
}
