@using Blazor.Shared.Components.FileDropZone
@using Microsoft.AspNetCore.Components.Forms
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@using Core.Shared.Instance.Models

<div class="settings-field-file-upload">
    <FileDropZone CssClass="file-drop-zone--grid"
                  OnDragEnter="FileDropZoneDragEnter"
                  OnDragLeave="FileDropZoneDragLeave"
                  OnDrop="FileDropZoneDrop"
                  @ref="_fileDropZone">
        @if (_dropIncoming)
        {
            <div class="drop-incoming-bg"></div>
        }

        <div class="filename">
            @if (_filename is not null)
            {
                @_filename
            }
            else
            {
                @_placeholder
            }
        </div>

        @if (_uploadTicket is not null)
        {
            if (_uploadProgress is not null)
            {
                var uploadProgressCssClasses = new List<string> { "upload-progress" };

                MonochromeIconName? uploadStatusIconName = null;

                if (_uploadResult is StreamUploadSuccessResult)
                {
                    uploadProgressCssClasses.Add("success");

                    uploadStatusIconName = MonochromeIconName.Check;
                }
                else if (_uploadResult is StreamUploadErrorResult)
                {
                    uploadProgressCssClasses.Add("error");

                    uploadStatusIconName = MonochromeIconName.ErrorFull;
                }

                <div class="@string.Join(" ", uploadProgressCssClasses)">
                    @if (uploadStatusIconName.HasValue)
                    {
                        <MonochromeIcon Name="@uploadStatusIconName.Value" Size="@MonochromeIconSize.SmallMedium" />
                    }
                    else
                    {
                        <span>@(_uploadProgress) %</span>
                    }
                </div>
            }
        }

        <SettingsFieldButton CssClass="choose-button"
                             Text="@CommonVocabulary.Choose"
                             IconCssClass="@_chooseButtonIconCssClasses"
                             OnClick="ChooseButtonClick" />

        @{
            var inputFileAttributes = new Dictionary<string, object> { { "class", "input-file" } };

            if (!string.IsNullOrWhiteSpace(Accept))
                inputFileAttributes.Add("accept", Accept);
        }

        <InputFile @attributes="inputFileAttributes" @ref="_inputFile" OnChange="FileDropped" />
        <InputFile @attributes="inputFileAttributes" @ref="_inputFileForShowPicker" OnChange="FilePicked" />

        @if (ChildContent is not null)
        {
            <div class="child-content">
                @ChildContent
            </div>
        }
    </FileDropZone>
</div>
