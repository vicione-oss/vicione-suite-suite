@using Blazor.Shared.Settings.Models
@using ViciOne.Ui.Blazor.Components.Accordion.Components
@using Blazor.Shared.Popup.Components
@using Blazor.Shared.Popup.Enums
@using Blazor.Shared.Settings.Extensions
@using ViciOne.Ui.Blazor.Components.LoadingSpinner.Components
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@if (_initialized)
{
    <div class="settings-container">
        <PopupMasterDetailLayout PopupTitle="@Localization.SettingsContainer.Title"
                                 ContentActionButtonsVisible="@IsAnyControlPanelEditRunning()">
            <PopupActionButtons>
                <PopupActionButton IconName="MonochromeIconName.CloseMedium" OnClick="@PopupCloseActionButtonClick" />
            </PopupActionButtons>

            <BeforeNavigation>
                <SearchBox Placeholder="@($"{CommonVocabulary.SearchVerb} ...")" Enabled="false" />
            </BeforeNavigation>

            <Navigation>
                <PopupScrollContainer>
                    <Content>
                        @foreach (var settingsGroup in _settingsGroups)
                        {
                            <Accordion @key="settingsGroup">

                                @foreach (var settingsCategory in _settingsCategoryMaps[settingsGroup].Values.Sort())
                                {
                                    var settingsEntriesKey = new SettingsEntriesKey { SettingsGroup = settingsGroup, SettingsCategory = settingsCategory };

                                    if (!_settingsEntriesMap.TryGetValue(settingsEntriesKey, out var settingsEntriesEnumerable))
                                        continue;

                                    var settingsEntries = settingsEntriesEnumerable.ToList();

                                    var isExpanded = State.ExpandedSettingsCategory == settingsCategory;
                                    var isActive = _activeSettingsEntry is not null && settingsEntries.Contains(_activeSettingsEntry);

                                    string? iconCssClass = settingsCategory.IconCssClass;
                                    Uri? iconUrl = settingsCategory.IconUrl;

                                    if (iconCssClass is null && iconUrl is null)
                                    {
                                        var firstSettingsEntry = settingsEntries.FirstOrDefault();
                                        if (firstSettingsEntry is not null)
                                            iconUrl = firstSettingsEntry.IconUrl;

                                        if (iconUrl is null)
                                            iconCssClass = "empty-icon";
                                    }

                                    <AccordionItem Title="@settingsCategory.Title"
                                                   Text="@settingsCategory.Title"
                                                   Expanded="@isExpanded"
                                                   CssClass="@(isActive ? "active" : null)"
                                                   IconCssClass="@iconCssClass"
                                                   IconUrl="@iconUrl"
                                                   OnBeforeExpand="@(async args => await OnBeforeExpandAccordionItem(args, settingsEntriesKey))"
                                                   OnBeforeCollapse="@(args => OnBeforeCollapseAccordionItem(args, settingsEntriesKey))"
                                                   @key="@settingsCategory.Title">

                                        @foreach (var settingsEntry in settingsEntries)
                                        {
                                            var cssClasses = new List<string> { "menu-entry" };

                                            if (settingsEntry == _activeSettingsEntry)
                                                cssClasses.Add("active");

                                            <button class="@string.Join(" ", cssClasses)"
                                                    @onclick="() => OnSettingsEntryClick(settingsEntry)"
                                                    @key=@settingsEntry.ControlPanelRegistryItem>

                                                <div class="menu-entry-guideline"></div>
                                                <div class="menu-entry-text">@settingsEntry.Title</div>
                                            </button>
                                        }
                                    </AccordionItem>
                                }
                            </Accordion>
                        }
                    </Content>

                    <AfterContent>
                        <PopupOverflowEffect CssClass="accordion-overflow" />
                    </AfterContent>
                </PopupScrollContainer>
            </Navigation>

            <ContentHeader>
                <SettingsContainerContentHeader />
            </ContentHeader>

            <Content>
                <ControlPanelCarousel />
            </Content>

            <ContentActionButtons>
                <PopupContentActionButtonContainer Enabled="@(LoadingIndicationPlacementBehavior.Placement == LoadingIndicationPlacement.None)"
                                                   ErrorMessageVisible="@(_lastSaveErrorResults.Count > 0)"
                                                   ShowLoadingIndication="@(LoadingIndicationPlacementBehavior.Placement == LoadingIndicationPlacement.ContentActionButtons)">
                    <ErrorMessage>
                        @foreach (var lastSaveErrorResult in _lastSaveErrorResults)
                        {
                            <div>@lastSaveErrorResult.Message</div>
                        }
                    </ErrorMessage>

                    <Buttons>
                        <PopupContentActionButton IconName="MonochromeIconName.Check"
                                                  Text="@CommonVocabulary.Confirm"
                                                  CssClass="popup-content-action-button--confirm"
                                                  OnClick="@ConfirmButtonClick" />

                        <PopupContentActionButton IconName="MonochromeIconName.CloseMedium"
                                                  Text="@CommonVocabulary.Cancel"
                                                  OnClick="@CancelControlPanelEdits" />
                    </Buttons>
                </PopupContentActionButtonContainer>
            </ContentActionButtons>

            <LoadingOverlay>
                <LoadingSpinner Messages="@LoadingSpinnerTimedMessages"
                                Visible="@(LoadingIndicationPlacementBehavior.Placement == LoadingIndicationPlacement.Overlay)" />
            </LoadingOverlay>

        </PopupMasterDetailLayout>
    </div>
}
