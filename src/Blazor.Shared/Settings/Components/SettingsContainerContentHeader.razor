@using ViciOne.Ui.Blazor.Components.TabStrip.Components
@using ViciOne.Ui.Blazor.Components.TabStrip.Enums
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<div class="settings-container-content-header">
    @if (SettingsModuleState.ShowNavigateBackButton)
    {
        <button class="navigate-back-button" @onclick="@NavigateBackButtonClick">
            <MonochromeIcon CssClass="icon" Name="@MonochromeIconName.ExpanderLightLeft" Size="MonochromeIconSize.MediumLarge" />
        </button>
    }

    @{
        var children = _activeControlPanelRegistryItem is not null ? GetChildren(_activeControlPanelRegistryItem) : [];
        var controlPanelPages = children.Count == 0 ? GetControlPanelPages() : [];

        if (children.Count > 0)
        {
            <div class="tab-control-container">
                <TabStrip @key="_activeControlPanelRegistryItem" ActiveTabIndex="@GetActiveTabIndex(children)" TabSize="TabSize.Large">
                    @if (ActiveItemHasOwnTab)
                    {
                        <Tab Text="@_activeControlPanelRegistryItem?.Descriptor.Title" OnSelected="@ControlPanelTabSelected" />
                    }

                    @foreach (var child in children)
                    {
                        <Tab Text="@child.Descriptor.Title" OnSelected="@ControlPanelTabSelected" />
                    }
                </TabStrip>
            </div>
        }
        else if (controlPanelPages.Count > 1)
        {
            <div class="tab-control-container">
                <TabStrip @key="_activeControlPanelRegistryItem" ActiveTabIndex="@GetActivePageIndex(controlPanelPages)" TabSize="TabSize.Large">
                    @foreach (var controlPanelPage in controlPanelPages)
                    {
                        <Tab Text="@controlPanelPage.Title" OnSelected="@ControlPanelPageTabSelected" />
                    }
                </TabStrip>
            </div>
        }
        else
        {
            <div class="control-panel-title">
                @GetControlPanelTitle(controlPanelPages.FirstOrDefault())
            </div>
        }
    }
</div>
