@using Blazor.Shared.Components
@using Sdk.Client.NotificationArea.Components.Layout
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Localization.Resources

<NotificationElementFlyoutContentLayout>
    <Main>
        <div class="search-area">
            <SearchBox Placeholder="@($"{CommonVocabulary.SearchVerb} ...")" Text="@_filter" TextChanging="@((value) => _filter = value)" />
        </div>
    </Main>
    <Footer>
        <div class="settings-button">
            <ExternalLinkButton Text="@Localization.SettingsNotificationElementFlyoutContent.OpenSettings" OnClick="OpenSettingsButtonClick" />
        </div>
    </Footer>
</NotificationElementFlyoutContentLayout>
