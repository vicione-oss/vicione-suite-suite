@using Blazor.Shared.Components
@using Blazor.Shared.Enums
@using Blazor.Shared.Extensions
@using Sdk.Client.Components.Cards.Components
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<div class="wrapper">
    <div class="search-area">
        <button class="arrow-back" @onclick="async () => await OnArrowBackClick()">
            <img src="@SvgIcon.ArrowBack.GetPath()" />
        </button>

        <button class="home" @onclick="async () => await ShowCardView()">
            <img src="@SvgIcon.Home.GetPath()" />
        </button>

        <SearchBox @bind-Text="@_filter" Placeholder="@($"{CommonVocabulary.SearchVerb} ...")" />
    </div>

    <div class="help-element-container">
        @if (_listView)
        {
            <CardList>
                @foreach (var help in GetHelpItems())
                {
                    <Card CardModel="help"
                          OnLinkClick="async (h) => await OnHelpClick(h)"
                          OnCloseClick="async (h) => await OnCloseClick(h)" />
                }
            </CardList>
        }
        else
        {
            <HelpDetail Help="_help"
                        OnLinkClick="async (Guid id) => await OnLinkClick(id)"/>
        }
    </div>

    <div class="footer">
        <ExternalLinkButton CssClass="full-page-link" Text="@Localization.HelpNotificationElementFlyoutContent.FullPageHelp" />

        <ExternalLinkButton CssClass="support-link" Text="@Localization.HelpNotificationElementFlyoutContent.RemoteSupport" />

        <div class="extra-menu">
            <span>@Localization.HelpNotificationElementFlyoutContent.Feedback</span>
            <span class="seperator">|</span>
            <span>@Localization.HelpNotificationElementFlyoutContent.LegalNotice</span>
            <span class="seperator">|</span>
            <span>@Localization.HelpNotificationElementFlyoutContent.Privacy</span>
        </div>
    </div>
</div>
