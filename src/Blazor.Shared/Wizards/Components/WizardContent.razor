@using Blazor.Shared.Components.UnsavedChangesPopup
@using Blazor.Shared.Settings.Components
@using Blazor.Shared.Wizards.Components
@using ViciOne.Ui.Blazor.Components.Popup.Components
@using PopupConstants = Blazor.Shared.Popup.Constants

@typeparam TContext

<Popup Height="@PopupConstants.PopupHeightPx"
       Width="@PopupConstants.PopupWidthPx"
       ZIndex="@PopupConstants.PopupZIndex"
       @bind-Visible="Visible"
       @bind-Visible:after="PopupVisibleChanged"
       @ref="_popup">

    <WizardBody TContext="TContext"
                Title="@Title"
                AllowExit="@AllowExit"
                OnExit="@WizardBodyOnExit"
                OnShowUnsavedChangesPopup="(() => _showUnsavedChangesPopup = true)"
                @ref="_wizardBody" />
</Popup>

<UnsavedChangesPopup OnCancel="@OnCancelUnsavedChanges"
                     OnRevert="@OnRevertUnsavedChanges"
                     OnSave="@OnSaveUnsavedChanges"
                     Visible="@_showUnsavedChangesPopup" />
