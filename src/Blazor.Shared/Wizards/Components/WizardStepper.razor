@using Blazor.Shared.Wizards.Extensions
@using Blazor.Shared.Wizards.Models

<div class="wizard-stepper">
    @if (_steps.Count > 0)
    {
        var activeStepNumber = _activeStep is not null ? _activeStep.Value.Number : default;

        var visibleStepNumbers = _steps.Select(step => step.Number).Reduce(activeStepNumber, maximumItems: 6);

        var visibleSteps = _steps.Where(step => visibleStepNumbers.Contains(step.Number)).ToList();

        var visibleStepNumbersInOrder = visibleSteps.Select(step => step.Number).ToList();

        for (var index = 0; index < visibleSteps.Count; index++)
        {
            var visibleStep = visibleSteps[index];

            if (index > 0)
            {
                <span class="@GetStepSeparatorCssClass(visibleStep.Number, visibleSteps[index - 1].Number, activeStepNumber)"></span>
            }

            <div class="@GetStepCssClass(visibleStepNumbersInOrder, index, activeStepNumber)">
                <span>@visibleStep.Number</span>
                <span>@visibleStep.Title</span>
            </div>
        }
    }
</div>
