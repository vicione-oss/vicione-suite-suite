@inherits LayoutComponentBase

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark login-nav-border box-shadow mb-3 login-nav-border">
        <div class="container">
            <div class="top-bar-app-name">
                <a href="~/"><span class="text-accent">ViciOne</span> Suite</a>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">

            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main class="login-layout-main-content">
        <div class="login-layout-main-body">
            @Body
        </div>
    </main>
</div>

<footer class="footer border-top pl-3 text-muted login-footer">
    <div class="container">
        &copy; @(DateTime.UtcNow.ToString("yyyy")) - ViciOne.Suite.Core.OS
    </div>
</footer>
