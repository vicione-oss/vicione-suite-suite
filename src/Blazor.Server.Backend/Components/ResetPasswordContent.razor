@using Blazor.Server.Backend.Enums
@using Blazor.Server.Backend.Localization
@using ViciOne.Ui.Localization.Resources

<EditForm EditContext="editContext" method="post" OnSubmit="OnPostSubmit" FormName="reset-password" class="@($"reset-password {(BuildingLayout ? "building" : "account")}")">
    <DataAnnotationsValidator />

    <TextInputField @bind-Value="@Input.Email"
                    Valid="@(context.FieldCssClass(() => Input.Email) == "valid")"
                    Placeholder="@CommonVocabulary.Email"
                    Name="Input.Email"
                    Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />

    <div class="password">
        <TextInputField @bind-Value="@Input.NewPassword"
                        Password="true"
                        Valid="@(context.FieldCssClass(() => Input.NewPassword) == "valid")"
                        Placeholder="@Common.NewPassword"
                        Name="Input.NewPassword"
                        Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />
    </div>

    <div class="password">
        <TextInputField @bind-Value="@Input.ConfirmNewPassword"
                        Password="true"
                        Valid="@(context.FieldCssClass(() => Input.ConfirmNewPassword) == "valid")"
                        Placeholder="@Common.ConfirmNewPassword"
                        Name="Input.ConfirmNewPassword"
                        Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />
    </div>

    <div class="button-section">
        <AccountButton Text="@Common.ChangePassword" ButtonType="@(BuildingLayout? AccountButtonType.Outline: AccountButtonType.Active)" />
    </div>
</EditForm>
