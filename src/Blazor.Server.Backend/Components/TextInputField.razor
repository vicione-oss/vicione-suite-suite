@using Sdk.Client.Extensions
@using ViciOne.Ui.Blazor.Components.TextBox
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@{
    var designType = Type.ToString().ToHyphenSeparated();
}

<div class="input-field @designType">
    <TextBox @bind-Value="@Value"
             @bind-Value:after="@TextBoxValueChanged"
             Password="@Password"
             Placeholder="@Placeholder"AutoComplete="@AutoComplete"
             Enabled="@Enabled"
             Name="@Name"
             Id="@_inputId"
             Valid="@Valid" />

    @if (Password)
    {
        <button type="button" class="show-button" data-toggle-password="@_inputId">
            <MonochromeIcon Name="MonochromeIconName.Show" Size="MonochromeIconSize.Small" CssClass="show-icon" />

            <MonochromeIcon Name="MonochromeIconName.Hide" Size="MonochromeIconSize.Small" CssClass="hide-icon" />
        </button>
    }

    <div class="validation-image">
        <MonochromeIcon Name="MonochromeIconName.WarningLight" Size="MonochromeIconSize.SmallMedium" />

        <div class="tooltip-info">
            <div class="tooltip-info-tab">
                <ValidationMessage For="@ValueExpression" class="message" />
            </div>
        </div>
    </div>
</div>

@if (Password)
{
    <script src="@Assets["js/text-input-field.js"]"></script>
}
