@using Blazor.Server.Backend.Enums
@using Blazor.Server.Backend.Localization
@using ViciOne.Ui.Localization.Resources
@using Blazor.Shared.Localization

<form id="@CancelFormId" method="get" action="/"></form>

<EditForm EditContext="_editContext" method="post" OnSubmit="OnPostSubmit" FormName="set-password" class="@($"set-password {(BuildingLayout ? "building" : "account")}")">
    <DataAnnotationsValidator />

    <TextInputField @bind-Value="@Input.NewPassword"
                    Password="true"
                    Valid="@(context.FieldCssClass(() => Input.NewPassword) == "valid")"
                    Placeholder="@Common.NewPassword"
                    Name="Input.NewPassword"
                    Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />

    <div class="password">
        <TextInputField @bind-Value="@Input.ConfirmPassword"
                        Password="true"
                        Valid="@(context.FieldCssClass(() => Input.ConfirmPassword) == "valid")"
                        Placeholder="@Common.ConfirmPassword"
                        Name="Input.ConfirmPassword"
                        Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />
    </div>

    <div class="button-section">
        <AccountButton Text="@CommonVocabulary.Cancel"
                       Form="@CancelFormId"
                       ButtonType="@(BuildingLayout ? AccountButtonType.Outline : AccountButtonType.Default)" />

        <AccountButton Text="@PasswordTerms.SetPassword"
                       ButtonType="@(BuildingLayout ? AccountButtonType.Outline : AccountButtonType.Active)" />
    </div>
</EditForm>
