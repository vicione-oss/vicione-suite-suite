@using Blazor.Server.Backend.Enums
@using Blazor.Server.Backend.Localization
@using Blazor.Shared.Profile.Models
@using Blazor.Shared.Profile.ControlPanels
@using ViciOne.Ui.Blazor.Components.CheckBox
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@if (IsExternalIdProviderConfigured)
{
    <form @formname="@_formId" id="@_formId" method="post" action="/account/perform-external-login">
        <AntiforgeryToken />
        <input type="hidden" name="provider" value="@_externalProviderName" />
        <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/")" />
    </form>

}
<EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login" class="@FormCssClass">
    <DataAnnotationsValidator />

    <TextInputField @bind-Value="@Input.Username"
                    Valid="@(context.FieldCssClass(() => Input.Username) == "valid")"
                    Placeholder="@CommonVocabulary.User"
                    Name="Input.Username"
                    AutoComplete="username webauthn"
                    Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />

    <div class="password">
        <TextInputField @bind-Value="@Input.Password"
                        Password="true"
                        Valid="@(context.FieldCssClass(() => Input.Password) == "valid")"
                        Placeholder="@CommonVocabulary.Password"
                        Name="Input.Password"
                        Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />
    </div>

    <div class="remember-forgot-section">
        <div class="remember-me">
            <CheckBox Value="@Input.RememberMe" Name="Input.RememberMePostBackValue" />
            <span class="text">@Login.RememberMe</span>
        </div>

        @if (SenderStatus.IsConfigured() && !BuildingLayout)
        {
            <NavigationField Route="@IdentityRoutes.ForgotPasswordRoute">
                <Content>
                    @Login.ForgotPassword
                </Content>
            </NavigationField>
        }
    </div>

    <div class="button-section">
        <AccountButton Text="@Login.Title"
                       ButtonType="@(BuildingLayout? AccountButtonType.Outline : AccountButtonType.Active)" />

        @if (IsExternalIdProviderConfigured || IsPasskeySignInEnabled)
        {
            <hr />
        }

        @if (IsExternalIdProviderConfigured)
        {
            <AccountButton Text="@($"{Login.LoginWithExternalProvider} {_externalProviderDisplayName}")"
                           IconName="@MonochromeIconName.ExternalIdProviderLight"
                           Form="@_formId"
                           ButtonType="@AlternativeSignInButtonType" />
        }

        @if (IsPasskeySignInEnabled)
        {
            <PasskeySubmit Operation="PasskeyOperation.Request"
                           Name="Input.Passkey"
                           UsernameField="Input.Username"
                           Text="@Login.LoginWithPasskey"
                           ButtonType="@AlternativeSignInButtonType"
                           Disabled="@(!IsPasskeyHostSupported)"
                           DisabledTitle="@Login.PasskeyRequiresDnsHost" />
            <ValidationMessage For="() => Input.Passkey" />
        }
    </div>

    @if (SenderStatus.IsConfigured() && BuildingLayout)
    {
        <div class="forgot-password">
            <NavigationField Route="@IdentityRoutes.ForgotPasswordRoute">
                <Content>
                    <MonochromeIcon Name="MonochromeIconName.LockActive" Size="MonochromeIconSize.Small" />

                    <label>@Login.ForgotPassword</label>
                </Content>
            </NavigationField>
        </div>
    }
</EditForm>
