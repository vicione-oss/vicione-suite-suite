@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@{
    var additionalAttributes = new Dictionary<string, object>();

    if (!string.IsNullOrEmpty(Form))
    {
        additionalAttributes.Add("form", Form);
    }
}

<button class="@CssClass"
        type="submit"
        disabled="@Disabled"
        name="@Name"
        title="@Title"
        aria-label="@Title"
        @attributes="additionalAttributes">
    @if (IconName is { } iconName)
    {
        <MonochromeIcon Name="@iconName" Size="MonochromeIconSize.Small" CssClass="icon" />
    }
    <span class="text">@Text</span>
</button>
