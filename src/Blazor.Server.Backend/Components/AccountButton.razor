@using Sdk.Client.Extensions

@{
    var additionalAttributes = new Dictionary<string, object>();

    if (!string.IsNullOrEmpty(Form))
    {
        additionalAttributes.Add("form", Form);
    }
}

<button class="account-button @(ButtonType.ToString().ToHyphenSeparated())" type="submit" disabled="@Disabled" @attributes="additionalAttributes">@Text</button>
