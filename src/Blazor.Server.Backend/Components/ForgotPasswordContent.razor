@using Blazor.Server.Backend.Areas.Identity.Pages.Account
@using Blazor.Server.Backend.Enums
@using Blazor.Server.Backend.Localization
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<EditForm method="post" OnValidSubmit="ResetPassword" FormName="forgot-password" Model="Input" class="@($"forgot-password {(BuildingLayout ? "building" : "account")}")">
    <DataAnnotationsValidator />

    <TextInputField @bind-Value="@Input.Email"
                    Valid="@(context.FieldCssClass(() => Input.Email) == "valid")"
                    Placeholder="@CommonVocabulary.Email"
                    Name="Input.Email"
                    Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />

    <div class="button-section">
        <AccountButton Text="@Common.ResetPassword" ButtonType="@(BuildingLayout? AccountButtonType.Outline : AccountButtonType.Active)" />
        <NavigationField Route="@IdentityRoutes.LoginRoute">
            <Content>
                <MonochromeIcon Name="MonochromeIconName.ArrowNavigationLightLeft" Size="MonochromeIconSize.Small" />

                <label>@Common.NavigateToLoginPage</label>
            </Content>
        </NavigationField>
    </div>
</EditForm>
