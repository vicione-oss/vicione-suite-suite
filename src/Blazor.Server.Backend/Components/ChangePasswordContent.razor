@using Blazor.Server.Backend.Enums
@using Blazor.Server.Backend.Localization
@using ViciOne.Ui.Localization.Resources

<form @onsubmit="OnCancel" @formname="cancel" id="@FormId" method="post">
    <AntiforgeryToken />
</form>

<EditForm EditContext="editContext" method="post" OnSubmit="OnPostSubmit" FormName="change-password" class="@($"change-password {(BuildingLayout ? "building": "account")}")">
    <DataAnnotationsValidator />

    <TextInputField @bind-Value="@Input.Username"
                    Placeholder="@CommonVocabulary.User"
                    Name="Input.Username"
                    Enabled="false"
                    Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />

    <div class="password">
        <TextInputField @bind-Value="@Input.Password"
                        Password="true"
                        Valid="@(context.FieldCssClass(() => Input.Password) == "valid")"
                        Placeholder="@CommonVocabulary.Password"
                        Name="Input.Password"
                        Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />
    </div>

    <div class="password">
        <TextInputField @bind-Value="@Input.NewPassword"
                        Password="true"
                        Valid="@(context.FieldCssClass(() => Input.NewPassword) == "valid")"
                        Placeholder="@Common.NewPassword"
                        Name="Input.NewPassword"
                        Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />
    </div>

    <div class="password">
        <TextInputField @bind-Value="@Input.ConfirmNewPassword"
                        Password="true"
                        Valid="@(context.FieldCssClass(() => Input.ConfirmNewPassword) == "valid")"
                        Placeholder="@Common.ConfirmNewPassword"
                        Name="Input.ConfirmNewPassword"
                        Type="@(BuildingLayout ? TextInputFieldTypes.Outline : TextInputFieldTypes.Default)" />
    </div>

    <div class="button-section">
        <AccountButton Text="@CommonVocabulary.Cancel"
                       Form="@ChangePasswordContent.FormId"
                       Disabled="@_passwordExpired"
                       ButtonType="@(BuildingLayout? AccountButtonType.Outline : AccountButtonType.Default)" />

        <AccountButton Text="@Common.ChangePassword"
                       ButtonType="@(BuildingLayout? AccountButtonType.Outline : AccountButtonType.Active)" />
    </div>
</EditForm>
