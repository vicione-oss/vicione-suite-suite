@page
@using Blazor.Shared
@using Sdk.Client.Components.Wallpaper.Extensions

@model Blazor.Server.Backend.Areas.Identity.Pages.Account.ConfirmEmail

@{
    ViewData["BackgroundImagePath"] = Constants.WallpaperImage.GetPath(Constants.WallpaperBaseUri);
}

<div class="background-test" style="--background-url: url(@(ViewData["BackgroundImagePath"]))">
    <div class="interaction-center">
        <div class="left-side">
            <div class="heading">
                @ViewData["Title"]
            </div>
            <div class="content">
                @if (Model.WasSuccessful)
                {
                    <div>
                        You successfully verified your E-Mail account.
                        <a asp-page="/Account/Login">Click here to log in.</a>
                    </div>
                }
                else
                {
                    <div>
                        Verifying you mail address failed. Please contact your administrator.
                    </div>
                }
            </div>
            <div class="spacer"></div>
        </div>
        <partial name="_InstanceInformation" />
    </div>
</div>
