@page "/account/forgot-password-confirmation"
@attribute [AllowAnonymous]

@using Blazor.Server.Backend.Components
@using Blazor.Server.Backend.Localization
@using Blazor.Shared.Components
@using ViciOne.Ui.Localization.Resources

<PageTitle>@Common.ForgotPassword</PageTitle>
<AccountLayout>
    <Heading>@Common.ForgotPassword</Heading>
    <LeftSideContent>
        <div>
            @Localization.ForgotPasswordConfirmation.SuccessMessage
        </div>
    </LeftSideContent>
</AccountLayout>
