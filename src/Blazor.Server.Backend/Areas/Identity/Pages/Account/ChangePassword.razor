@attribute [Route(IdentityConstants.ChangePasswordRoute)]

@using Blazor.Server.Backend.Components
@using Blazor.Server.Backend.Enums
@using Blazor.Shared.Components
@using ViciOne.Ui.Localization.Resources

<PageTitle>@Localization.ChangePassword.Title</PageTitle>
<AccountLayout>
    <Heading>@Localization.ChangePassword.Title</Heading>
    <LeftSideContent>
        <form @onsubmit="OnCancel" @formname="cancel" id="cancel-change-password" method="post">
            <AntiforgeryToken />
        </form>
        <EditForm EditContext="editContext" method="post" OnSubmit="OnPostSubmit" FormName="change-password">
            <DataAnnotationsValidator />

            <TextInputField @bind-Value="@Input.Username"
                            Placeholder="@CommonVocabulary.User"
                            Name="Input.Username"
                            Enabled="false" />

            <div class="password">
                <TextInputField @bind-Value="@Input.Password"
                                Password="true"
                                Valid="@(context.FieldCssClass(() => Input.Password) == "valid" ? true : false)"
                                Placeholder="@CommonVocabulary.Password"
                                Name="Input.Password" />
            </div>

            <div class="password">
                <TextInputField @bind-Value="@Input.NewPassword"
                                Password="true"
                                Valid="@(context.FieldCssClass(() => Input.NewPassword) == "valid" ? true : false)"
                                Placeholder="@Localization.Common.NewPassword"
                                Name="Input.NewPassword" />
            </div>

            <div class="password">
                <TextInputField @bind-Value="@Input.ConfirmNewPassword"
                                Password="true"
                                Valid="@(context.FieldCssClass(() => Input.ConfirmNewPassword) == "valid" ? true : false)"
                                Placeholder="@Localization.Common.ConfirmNewPassword"
                                Name="Input.ConfirmNewPassword" />
            </div>

            <div class="button-section">
                <AccountButton Text="@CommonVocabulary.Cancel" Form="cancel-change-password" Disabled="@_passwordExpired" />

                <AccountButton Text="@Localization.ChangePassword.Title" ButtonType="AccountButtonType.Active" />
            </div>
        </EditForm>
    </LeftSideContent>
</AccountLayout>
