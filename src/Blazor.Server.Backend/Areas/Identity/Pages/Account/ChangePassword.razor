@attribute [Route(IdentityRoutes.ChangePasswordRoute)]

@using Blazor.Server.Backend.Components
@using Blazor.Server.Backend.Localization
@using Blazor.Shared.Components
@using Core.Shared.Instance.Contracts

<PageTitle>@Common.ChangePassword</PageTitle>

@if (LoginDesignService.Design == LoginDesign.BuildingAutomation)
{
    <div class="building-layout">
        <BuildingAutomationLayout Heading="@Common.ChangePassword">
            <ChildContent>
                <ChangePasswordContent Input="@Input"
                                       User="@User"
                                       IsPersistent="@IsPersistent"
                                       ReturnRoute="@ReturnUrl"
                                       BuildingLayout="true" />
            </ChildContent>
        </BuildingAutomationLayout>
    </div>
}
else
{
    <div class="account-layout">
        <AccountLayout>
            <Heading>@Common.ChangePassword</Heading>
            <LeftSideContent>
                <ChangePasswordContent Input="@Input"
                                       User="@User"
                                       IsPersistent="@IsPersistent"
                                       ReturnRoute="@ReturnUrl"/>
            </LeftSideContent>
        </AccountLayout>
    </div>
}
