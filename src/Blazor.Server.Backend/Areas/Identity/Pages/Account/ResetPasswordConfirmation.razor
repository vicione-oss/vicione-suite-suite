@attribute [Route(IdentityRoutes.ResetPasswordConfirmationRoute)]
@attribute [AllowAnonymous]

@using Blazor.Server.Backend.Components
@using Blazor.Server.Backend.Enums
@using Blazor.Server.Backend.Localization
@using Blazor.Shared.Components
@using Blazor.Shared.Enums
@using Blazor.Shared.Extensions
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<PageTitle>@Common.ResetPassword</PageTitle>
<AccountLayout>
    <Heading>@Common.ResetPassword</Heading>
    <LeftSideContent>
        <div>
            @Localization.ResetPasswordConfirmation.SuccessMessage

            <NavigationField Route="@IdentityRoutes.LoginRoute">
                <Content>
                    <MonochromeIcon Name="MonochromeIconName.ArrowNavigationLightLeft" Size="MonochromeIconSize.Small" />

                    <label>@Common.NavigateToLoginPage</label>
                </Content>
            </NavigationField>
        </div>
    </LeftSideContent>
</AccountLayout>
