@attribute [Route(IdentityConstants.ResetPasswordConfirmationRoute)]
@attribute [AllowAnonymous]

@using Blazor.Server.Backend.Components
@using Blazor.Server.Backend.Enums
@using Blazor.Shared.Components
@using Blazor.Shared.Enums
@using Blazor.Shared.Extensions
@using ViciOne.Ui.Localization.Resources

<PageTitle>@Localization.Common.ResetPassword</PageTitle>
<AccountLayout>
    <Heading>@Localization.Common.ResetPassword</Heading>
    <LeftSideContent>
        <div>
            @Localization.ResetPasswordConfirmation.SuccessMessage

            <NavigationField Route="@IdentityConstants.LoginRoute">
                <Content>
                    <img src="@(SvgIcon.Back.GetPath())" />

                    <label>@Localization.Common.NavigateToLoginPage</label>
                </Content>
            </NavigationField>
        </div>
    </LeftSideContent>
</AccountLayout>
