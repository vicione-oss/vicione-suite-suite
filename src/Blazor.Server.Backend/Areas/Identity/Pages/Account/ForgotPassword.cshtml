@page
@using Blazor.Server.Backend.Areas.Identity.Pages.Account.Localization
@using Blazor.Shared
@using Blazor.Shared.Enums
@using Blazor.Shared.Extensions
@using Sdk.Client.Components.Wallpaper.Extensions
@model Blazor.Server.Backend.Areas.Identity.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = ForgotPassword.Title;
    ViewData["ResetPassword"] = ForgotPassword.ResetPassword;
    ViewData["NavigateToLoginPage"] = Common.NavigateToLoginPage;
    ViewData["BackgroundImagePath"] = Constants.WallpaperImage.GetPath(Constants.WallpaperBaseUri);
}

<div class="background-test" style="--background-url: url(@(ViewData["BackgroundImagePath"]))">
    <div class="interaction-center">
        <div class="left-side">
            <div class="heading">
                @ViewData["Title"]
            </div>
            <div class="content">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input asp-for="Input.Email" class="text-input" autocomplete="username" aria-required="true"
                           placeholder="Email" />
                    <div class="forgot-password-button-section">
                        <button type="submit" class="action-button">
                            @ViewData["ResetPassword"]
                        </button>
                        <div class="navigation-field">
                            <a asp-page="/Account/Login" asp-area="Identity">
                                <img src="@(SvgIcon.Back.GetPath())" />
                                <label>@ViewData["NavigateToLoginPage"]</label>
                            </a>
                        </div>
                    </div>
                </form>
            </div>
            <div class="spacer"></div>
        </div>
        <partial name="_InstanceInformation" />
    </div>
</div>
