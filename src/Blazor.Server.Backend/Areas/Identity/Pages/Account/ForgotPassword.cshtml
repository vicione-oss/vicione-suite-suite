@page
@using Blazor.Shared
@using Sdk.Client.Components.Wallpaper.Extensions
@model Blazor.Server.Backend.Areas.Identity.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot your password?";
    ViewData["BackgroundImagePath"] = Constants.WallpaperImage.GetPath(Constants.WallpaperBaseUri);
}

<div class="background-test" style="--background-url: url(@(ViewData["BackgroundImagePath"]))">
    <div class="interaction-center">
        <div class="left-side">
            <div class="heading">
                @ViewData["Title"]
            </div>
            <div class="content">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"
                               placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>
                </form>
            </div>
            <div class="spacer"></div>
        </div>
        <partial name="_InstanceInformation" />
    </div>
</div>
