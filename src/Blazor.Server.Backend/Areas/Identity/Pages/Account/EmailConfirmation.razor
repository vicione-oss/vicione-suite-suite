@attribute [Route(IdentityRoutes.EmailConfirmationRoute)]
@attribute [AllowAnonymous]

@using Blazor.Server.Backend.Components
@using Blazor.Shared.Components
@using ViciOne.Ui.Localization.Resources

<PageTitle>@Localization.EmailConfirmation.Title</PageTitle>
<AccountLayout>
    <Heading>@Localization.EmailConfirmation.Title</Heading>
    <LeftSideContent>
        <div>
            <label>@Localization.EmailConfirmation.ConfirmationIsRequiredText</label>
            <label>@Localization.EmailConfirmation.HowToConfirmText</label>

            <NavigationField Route="@IdentityRoutes.ResendEmailConfirmationRoute">
                <Content>
                    @Localization.EmailConfirmation.ClickHere
                </Content>
            </NavigationField>
        </div>
    </LeftSideContent>
</AccountLayout>
