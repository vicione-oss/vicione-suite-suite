@attribute [Route(IdentityRoutes.SetPasswordRoute)]

@using Blazor.Server.Backend.Components
@using Blazor.Shared.Components
@using Core.Shared.Instance.Contracts
@using Blazor.Shared.Localization

<PageTitle>@PasswordTerms.SetPassword</PageTitle>

@if (LoginDesignService.Design == LoginDesign.BuildingAutomation)
{
    <div class="building-layout">
        <BuildingAutomationLayout Heading="@PasswordTerms.SetPassword">
            <ChildContent>
                <SetPasswordContent Input="@Input" BuildingLayout="true" />
            </ChildContent>
        </BuildingAutomationLayout>
    </div>
}
else
{
    <div class="account-layout">
        <AccountLayout>
            <Heading>@PasswordTerms.SetPassword</Heading>
            <LeftSideContent>
                <SetPasswordContent Input="@Input" />
            </LeftSideContent>
        </AccountLayout>
    </div>
}
