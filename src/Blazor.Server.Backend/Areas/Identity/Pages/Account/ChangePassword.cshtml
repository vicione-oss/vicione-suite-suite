@page "/account/change-password"
@* This route needs to be set this way, otherwise the "MapRazorPages" method would map it to "identity/account/change-password". *@
@using Blazor.Shared.Enums
@using Blazor.Shared.Extensions
@using Blazor.Shared.Services
@using Sdk.Instance
@using System.Reflection

@inject IInstanceInformationProvider InstanceInformation
@inject CopyrightYearProvider CopyrightYearProvider

@model Blazor.Server.Backend.Areas.Identity.Pages.Account.ChangePasswordModel

<div class="background-test" style="--background-url: url(@(ViewData["BackgroundImagePath"]))">
    <div class="interaction-center">
        <div class="left-side">
            <div class="heading">
                @ViewData["Title"]

                @if (!string.IsNullOrEmpty(Model.PasswordExpiredMessage))
                {
                    <div class="description">
                        @Model.PasswordExpiredMessage
                    </div>
                }
            </div>
            <div class="content">
                <form id="account" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div>
                        <input asp-for="Input.Username" class="text-input" readonly />
                    </div>
                    <div>
                        <input asp-for="Input.Password" class="text-input password" placeholder="@ViewData["Password"]" />
                    </div>
                    <div>
                        <input asp-for="Input.NewPassword" class="text-input password" placeholder="@ViewData["NewPassword"]" />
                    </div>
                    <div>
                        <input asp-for="Input.ConfirmNewPassword" class="text-input password last" placeholder="@ViewData["ConfirmNewPassword"]" />
                    </div>
                    <div class="button-section reverse">
                        <button asp-page-handler="Submit" class="action-button">
                            @ViewData["Title"]
                        </button>
                        <button asp-page-handler="Cancel" class="action-button default cancel" disabled="@(!string.IsNullOrEmpty(Model.PasswordExpiredMessage))">
                            @ViewData["Cancel"]
                        </button>
                    </div>
                </form>
            </div>
            <div class="spacer"></div>
        </div>
        <div class="right-side">
            <label class="moneo-connect">
                <label class="moneo">moneo</label>
                <label class="seperator">|</label>
                connect
            </label>
            <div class="logo">
                <img src="@SvgIcon.IfmLogo.GetPath()" draggable="false" />
            </div>
            <div class="version-information">
                <div>ifm software gmbh @(CopyrightYearProvider.Year)</div>
                <div class="version-number" title="@InstanceInformation.Local.Version">ViciOne Suite @InstanceInformation.Local.Version</div>
                @if (InstanceInformation.Local.BranchName is not null)
                {
                    <div class="version-number" title="@InstanceInformation.Local.BranchName">@InstanceInformation.Local.BranchName</div>
                }
            </div>
        </div>
    </div>
</div>
