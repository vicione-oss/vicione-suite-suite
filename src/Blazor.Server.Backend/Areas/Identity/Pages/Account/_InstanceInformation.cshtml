@using Blazor.Shared.Enums
@using Blazor.Shared.Extensions
@using Blazor.Shared.Services
@using Sdk.Instance
@inject IInstanceInformationProvider InstanceInformation
@inject CopyrightYearProvider CopyrightYearProvider

<div class="right-side">
    <label class="instance-title">
        <label>@Html.Raw(InstanceInformation.GetFormatedInstanceTitle())</label>
    </label>
    <div class="logo">
        <img src="@SvgIcon.IfmLogo.GetPath()" draggable="false" />
    </div>
    <div class="version-information">
        <div>ifm software gmbh @(CopyrightYearProvider.Year)</div>
        <div class="version-number" title="@InstanceInformation.Local.Version">ViciOne
            Suite @InstanceInformation.Local.Version</div>
        @if (InstanceInformation.Local.BranchName is not null)
        {
            <div class="version-number"
                 title="@InstanceInformation.Local.BranchName">@InstanceInformation.Local.BranchName</div>
        }
    </div>
</div>
