@attribute [Route(IdentityConstants.ConfirmMailRoute)]


@*
This page must be accessible without prior authentication ([AllowAnonymous]).
When 'RequireAccountVerificationToLogIn' is enabled, users must verify their
email address before they can log in. This means the email confirmation page
must be reachable without an active session, as the user has not yet been
able to complete the login process.
*@
@attribute [AllowAnonymous]

@using Blazor.Server.Backend.Components
@using Blazor.Server.Backend.Localization
@using Blazor.Shared.Components
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<PageTitle>@Localization.ConfirmEmail.Title</PageTitle>
<AccountLayout>
    <Heading>@Localization.ConfirmEmail.Title</Heading>
    <LeftSideContent>
        <div>
            @if (_wasSuccessful is null)
            {
                <label>@(string.Format(Localization.ConfirmEmail.UserNotFound, UserId))</label>
            }
            else if (_wasSuccessful is true)
            {
                <label>@Localization.ConfirmEmail.VerificationSuccessful</label>
                <NavigationField Route="@IdentityConstants.LoginRoute">
                    <Content>
                        <MonochromeIcon Name="MonochromeIconName.ArrowNavigationLightLeft" Size="MonochromeIconSize.Small" />

                        <label>@Common.NavigateToLoginPage</label>
                    </Content>
                </NavigationField>
            }
            else
            {
                <label>@Localization.ConfirmEmail.VerifyingFailed</label>
            }
        </div>
    </LeftSideContent>
</AccountLayout>
