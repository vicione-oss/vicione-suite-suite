@attribute [Route(IdentityConstants.LoginRoute)]

@using Blazor.Server.Backend.Components
@using Blazor.Shared.Components
@using Core.Shared.Instance.Contracts

<PageTitle>@Backend.Localization.Login.Title</PageTitle>

@if (LoginDesignService.Design == LoginDesign.BuildingAutomation)
{
    <div class="building-layout">
        <BuildingAutomationLayout Heading="@Backend.Localization.Login.Title">
            <ChildContent>
                <LoginContent BuildingLayout="true" />
            </ChildContent>
        </BuildingAutomationLayout>
    </div>
}
else
{
    <div class="account-layout">
        <AccountLayout>
            <Heading>@Backend.Localization.Login.Title</Heading>
            <LeftSideContent>
                <LoginContent />
            </LeftSideContent>
        </AccountLayout>
    </div>
}
