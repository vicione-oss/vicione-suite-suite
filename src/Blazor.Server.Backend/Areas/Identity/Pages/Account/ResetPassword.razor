@attribute [Route(IdentityRoutes.ResetPasswordRoute)]

@using Blazor.Server.Backend.Components
@using Blazor.Server.Backend.Localization
@using Blazor.Shared.Components
@using Core.Shared.Instance.Contracts

<PageTitle>@Common.ResetPassword</PageTitle>

@if (LoginDesignService.Design == LoginDesign.BuildingAutomation)
{
    <div class="building-layout">
        <BuildingAutomationLayout Heading="@Common.ResetPassword">
            <ChildContent>
                <ResetPasswordContent Code="@Code" BuildingLayout="true" />
            </ChildContent>
        </BuildingAutomationLayout>
    </div>
}
else
{
    <div class="account-layout">
        <AccountLayout>
            <Heading>@Common.ResetPassword</Heading>
            <LeftSideContent>
                <ResetPasswordContent Code="@Code" />
            </LeftSideContent>
        </AccountLayout>
    </div>
}
