@page "/template/forgot-password"
@using Blazor.Server.Backend.Components
@using Blazor.Server.Backend.Enums
@using Blazor.Shared.Components
@using Blazor.Shared.Enums
@using Blazor.Shared.Extensions
@using ViciOne.Ui.Localization.Resources

<PageTitle>@Localization.ForgotPassword.Title</PageTitle>

<AccountLayout>
    <Heading>@Localization.ForgotPassword.Title</Heading>
    <LeftSideContent>
        <EditForm method="post" OnValidSubmit="ResetPassword" FormName="forgot-password" Model="Input">
            <DataAnnotationsValidator />

            <TextInputField @bind-Value="@Input.Username"
                            Valid="@(context.FieldCssClass(() => Input.Username) == "valid")"
                            Placeholder="@CommonVocabulary.User"
                            Attributes="@(new() { { "autocomplete", "username" }, { "aria-required", true } })"/>

            <div class="button-section">
                <AccountButton Text="@Localization.ForgotPassword.ResetPassword" ButtonType="AccountButtonType.Active" Submit="true" />
                <NavigationField Route="/template/login">
                    <Content>
                        <img src="@(SvgIcon.Back.GetPath())" />

                        <label>@Localization.Common.NavigateToLoginPage</label>
                    </Content>
                </NavigationField>
            </div>
        </EditForm>
    </LeftSideContent>
</AccountLayout>
