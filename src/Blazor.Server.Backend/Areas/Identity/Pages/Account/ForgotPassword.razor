@attribute [Route(IdentityRoutes.ForgotPasswordRoute)]

@using Blazor.Server.Backend.Components
@using Blazor.Server.Backend.Localization
@using Blazor.Shared.Components
@using Core.Shared.Instance.Contracts

<PageTitle>@Common.ForgotPassword</PageTitle>

@if (LoginDesignService.Design == LoginDesign.BuildingAutomation)
{
    <div class="building-layout">
        <BuildingAutomationLayout Heading="@Common.ForgotPassword">
            <ChildContent>
                <ForgotPasswordContent BuildingLayout="true" />
            </ChildContent>
        </BuildingAutomationLayout>
    </div>
}
else
{
    <div class="account-layout">
        <AccountLayout>
            <Heading>@Common.ForgotPassword</Heading>
            <LeftSideContent>
                <ForgotPasswordContent />
            </LeftSideContent>
        </AccountLayout>
    </div>
}
