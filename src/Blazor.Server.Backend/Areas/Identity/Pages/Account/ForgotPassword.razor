@attribute [Route(IdentityConstants.ForgotPasswordRoute)]

@using Blazor.Server.Backend.Components
@using Blazor.Server.Backend.Enums
@using Blazor.Shared.Components
@using Blazor.Shared.Enums
@using Blazor.Shared.Extensions
@using ViciOne.Ui.Localization.Resources

<PageTitle>@Localization.Common.ForgotPassword</PageTitle>

<AccountLayout>
    <Heading>@Localization.Common.ForgotPassword</Heading>
    <LeftSideContent>
        <EditForm method="post" OnValidSubmit="ResetPassword" FormName="forgot-password" Model="Input">
            <DataAnnotationsValidator />

            <TextInputField @bind-Value="@Input.Email"
                            Valid="@(context.FieldCssClass(() => Input.Email) == "valid")"
                            Placeholder="@CommonVocabulary.Email"
                            Name="Input.Email" />

            <div class="button-section">
                <AccountButton Text="@Localization.Common.ResetPassword" ButtonType="AccountButtonType.Active" />
                <NavigationField Route="@IdentityConstants.LoginRoute">
                    <Content>
                        <img src="@(SvgIcon.Back.GetPath())" />

                        <label>@Localization.Common.NavigateToLoginPage</label>
                    </Content>
                </NavigationField>
            </div>
        </EditForm>
    </LeftSideContent>
</AccountLayout>
