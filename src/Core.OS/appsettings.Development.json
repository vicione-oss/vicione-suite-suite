{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Error",
            "Microsoft.Hosting.Lifetime": "Information",
            "Microsoft.EntityFrameworkCore": "Error",
            "Microsoft.AspNetCore.Authentication": "Warning"
        },
        "LogTargets": [
            "Console"
        ]
    },
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:5000"
            },
            "Https": {
                "Url": "https://localhost:5001",
                "StoreName": "My",
                "StoreLocation": "CurrentUser"
            }
        }
    },
    "HostManagement": {
        "MockClient": {
            "Enabled": true,
            "DataSource": "SystemConfigurationEmbedded"
        }
    },
    "Instance": {
        "Type": "Standalone",
        "LoginDesign": "Default"
    },
    "MessageBus": {
        "UseInMemoryBus": true
    },
    "MqttClient": {
        "WebSocketClient": {
            "Endpoint": "wss://localhost/mqtt",
            "Port": 5001,
            "UserName": "",
            "Password": "",
            "TopicFilter": "data"
        },
        "ServiceClient": {
            "Endpoint": "localhost",
            "Port": 1883,
            "UserName": "",
            "Password": ""
        }
    },
    "ModuleLoader": {
        "ModulesPath": "suite-modules",
        "UiHostsPath": "src",
        "UseTypeValidation": "false",
        "ModuleDebugPaths": [
            "samples"
        ]
    },
    "UserManagement": {
        "SeedTestUsers": true
    },
    "ViciOne.Suite.Blazor.Server": {
        "EnableDetailedErrors": true,
        "UseDebugRoot": true
    },
    "FeatureManagement": { }
}
