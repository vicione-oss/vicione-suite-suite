{
    "profiles": {
        "Standalone-Ui": {
            "commandName": "Project",
            "launchBrowser": false,
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development",

                "Instance__Type": "Standalone",
                "Instance__HomeDirectory": "AppData_Standalone",
                "Instance__CacheDirectory": "Cache_Standalone",
                "Instance__BackupDirectory": "Backup_Standalone",
                "VICIONE_SUITE_ENV_OVERRIDES": "true"
            },
            "applicationUrl": "https://localhost:5001;http://localhost:5000"
        },
        "Master-Ui": {
            "commandName": "Project",
            "launchBrowser": false,
