{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Error",
            "Microsoft.EntityFrameworkCore": "Error",
            "MassTransit": "Warning"
        },
        "LogTargets": [
            "Journal"
        ],
        "LogPath": "AppData"
    },
    "AllowedHosts": "*",
    "Instance": {
        "HomeDirectory": "AppData",
        "CacheDirectory": "Cache",
        "BackupDirectory": "Backup"
    },
    "HostManagement": {
        "MockClient": {
            "Enabled": true
        }
    },
    "ArtifactRepository": {
        "Sources": []
    },
    "ModuleLoader": {
        "UiHost": "ViciOne.Suite.Blazor.Server"
    },
    "SystemMonitoring": {
        "Collectors": {
            "Thermal_Sensors": false
        }
    },
    "FeatureManagement": {}
}
