{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "inlineSourceMap": true,
        "inlineSources": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitOverride": true,
        "skipLibCheck": true,
        "types": [ "blazor__javascript-interop" ]
    },
    "exclude": [
        "node_modules"
    ]
}
