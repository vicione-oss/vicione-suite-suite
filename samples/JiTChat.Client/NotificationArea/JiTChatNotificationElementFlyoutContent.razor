@using Public.Contracts
@using Microsoft.AspNetCore.Components.Authorization
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.TextBox
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Localization.Extensions

@inherits ComponentBase

<hidden>@(OnDraw())</hidden>
<div class="jit-chat-content">
    <AuthorizeView Policy="@Policy">
        <Authorized>
            <div class="jit-chat-messages" id="jit-chat-message-box">
                @{ ChatMessage? lastMessage = null; }
                @foreach (var message in JiTChatService.ChatMessages)
                {
                    @if (Math.Floor(new TimeSpan(message.Time.Ticks).TotalMinutes) - Math.Floor(new TimeSpan((lastMessage?.Time ?? DateTimeOffset.MinValue).Ticks).TotalMinutes) != 0)
                    {
                        <div class="jit-chat-timestamp">
                            <p>@(message.Time.AdjustToTimeZone(TimeProvider.LocalTimeZone).LocalizeFullDateLongTime())</p>
                        </div>

                        lastMessage = message;
                    }

                    <div class="@($"{(message.User == Username ? "jit-chat-my-message" : string.Empty)} jit-chat-message")">
                        <div class="jit-chat-message-info">
                            <p>@(message.User)</p>
                        </div>
                        <p>@(message.Message)</p>
                    </div>
                }
            </div>

            <div class="jit-chat-input">
                <TextBox @bind-Value="@MessageText"
                         EnterPressed="@MessageTextEnterPressed"/>

                <Button IconCssClass="@_sendButtonIconCssClass"
                        Title="Submit"
                        Size="@ButtonSize.Small"
                        OnClick="@SubmitButtonPressed" />
            </div>
        </Authorized>
        <NotAuthorized>
            You are not supposed to be here!
        </NotAuthorized>
    </AuthorizeView>
</div>
