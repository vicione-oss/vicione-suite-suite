@using Sdk.Authorization
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@inherits ModulePageBase<BurgerClientModule>
@attribute [Route(BurgerClientModule.ModuleRoute)]
@attribute [ModuleAuthorize<BurgerClientModule>]

<div class="burger-page">
    <div class="burger-toolbar">
        <Toolbar>
            <ToolbarGroup>
                <ToolbarButton Text="Compose your burger:"
                               Enabled="false"/>

                <ToolbarButton Text="Cheese"
                               OnClick="@(() => { Burger.Cheese = !Burger.Cheese; })"
                               IconName="@(Burger.Cheese ? MonochromeIconName.Check : MonochromeIconName.CloseMedium)"/>

                <ToolbarButton Text="Pickle"
                               OnClick="@(() => { Burger.Pickle = !Burger.Pickle; })"
                               IconName="@(Burger.Pickle ? MonochromeIconName.Check : MonochromeIconName.CloseMedium)"/>

                <ToolbarButton Text="Ketchup"
                               OnClick="@(() => { Burger.Ketchup = !Burger.Ketchup; })"
                               IconName="@(Burger.Ketchup ? MonochromeIconName.Check : MonochromeIconName.CloseMedium)"/>

                <ToolbarButton Text="Mustard"
                               OnClick="@(() => { Burger.Mustard = !Burger.Mustard; })"
                               IconName="@(Burger.Mustard ? MonochromeIconName.Check : MonochromeIconName.CloseMedium)"/>

                <ToolbarButton Text="BarbecueSauce"
                               OnClick="@(() => { Burger.BarbecueSauce = !Burger.BarbecueSauce; })"
                               IconName="@(Burger.BarbecueSauce ? MonochromeIconName.Check : MonochromeIconName.CloseMedium)"/>

                <ToolbarButton Text="Onion"
                               OnClick="@(() => { Burger.Onion = !Burger.Onion; })"
                               IconName="@(Burger.Onion ? MonochromeIconName.Check : MonochromeIconName.CloseMedium)"/>

                <ToolbarButton Text="Lettuce"
                               OnClick="@(() => { Burger.Lettuce = !Burger.Lettuce; })"
                               IconName="@(Burger.Lettuce ? MonochromeIconName.Check : MonochromeIconName.CloseMedium)"/>

                <ToolbarButton Text="Error"
                               OnClick="@(() => throw new InvalidOperationException("You wanted this!"))"
                               IconName="MonochromeIconName.Urgent"/>
            </ToolbarGroup>
            
            <ToolbarGroup AlignRight>
                <ToolbarButton Text="Submit Order"
                               OnClick="@SubmitBurgerOrder"
                               IconName="MonochromeIconName.Email"/>
            </ToolbarGroup>
        </Toolbar>
    </div>
    <div class="burger-table">
        <table class="table">
            <thead>
            <tr>
                <th scope="col">OrderId</th>
                <th scope="col">State</th>
                <th scope="col">Description</th>
                <th scope="col">Created</th>
                <th scope="col">Delivered</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var order in BurgerService.Orders)
            {
                <tr id="@order.OrderId">
                    <th scope="row">@order.OrderId</th>
                    <td>@order.State</td>
                    <td>@order.Description</td>
                    <td>@order.OrderedWhen</td>
                    <td>@order.DeliveredWhen</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
