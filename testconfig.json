{
    "codeCoverage": {
        "Configuration": {
            "CodeCoverage": {
                "Attributes": {
                    "Exclude": {
                        "Attribute": [
                            "^System\\.CodeDom\\.Compiler\\.GeneratedCodeAttribute$",
                            "^System\\.Diagnostics\\.CodeAnalysis\\.ExcludeFromCodeCoverageAttribute$"
                        ]
                    }
                },
                "Sources": {
                    "Exclude": [
                        ".*.g.cs"
                    ]
                },
                "ModulePaths": {
                    "Exclude": {
                        "ModulePath": [
                            ".*Facts.dll",
                            ".*Tests.dll"
                        ]
                    }
                }
            }
        }
    }
}
