<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <RunConfiguration>
        <ResultsDirectory>artifacts/tests</ResultsDirectory>
    </RunConfiguration>
    <LoggerRunSettings>
        <Loggers>
            <Logger friendlyName="junit">
                <Configuration>
                    <LogFilePath>../../artifacts/tests/{assembly}-test-report.xml</LogFilePath>
                    <FailureBodyFormat>Verbose</FailureBodyFormat>
                </Configuration>
            </Logger>
        </Loggers>
    </LoggerRunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>
                    <!-- Für die Ermittlung der Codeabdeckung mit Coverlet kann folgende Anleitung verwendet werden: https://github.com/tonerdo/coverlet#vstest-integration-preferred-due-to-known-issue -->
                    <Format>cobertura</Format>
                    <Exclude>[*Test*]*,[*Fact*]*</Exclude>
                    <ExcludeByAttribute>GeneratedCode,Migration,DbContext</ExcludeByAttribute>
                    <IncludeTestAssembly>false</IncludeTestAssembly>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>
